{
  // Static Astro site served as Cloudflare Workers static assets (no Worker script).
  "name": "trnq-eu",
  "compatibility_date": "2026-11-14",
  // Served only on the custom domain; www.trnq.eu is redirected by a zone Redirect Rule.
  "routes": [{ "pattern": "trnq.eu", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // foo/index.html is served at /foo/ (matches the trailing-slash canonicals).
    "html_handling": "auto-trailing-slash"
  }
}
