---
export interface Props {
  lang: 'en' | 'it';
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;

const featured = [
  {
    slug: 'eblioteque',
    title: 'Eblioteque',
    kicker: { it: 'Archivi - Cataloghi', en: 'Archives - Catalogues' },
    excerpt: {
      it: "La mia biblioteca digitale.",
      en: "My e-biblioteque.",
    },
  },
  {
    slug: 'sottolinee',
    title: 'Sottolinee / Underlines',
    kicker: { it: 'Archivi - Cataloghi', en: 'Archives - Catalogues' },
    excerpt: {
      it: "Una collezione di sottolineature di libri.",
      en: "A collection of underlines from books.",
    },
  },
  {
    slug: 'promptsoncanvas',
    title: 'Prompts on canvas',
    kicker: { it: 'Galleria', en: 'Gallery' },
    excerpt: {
      it: "Esperimenti di arte generativa: il prompt come pennellata, l'errore come stile. Una galleria che riscrive i capolavori — dalla GiocondA.I. a Guernica — al confine tra istruzione e caso.",
      en: "Generative-art experiments: the prompt as brushstroke, error as style. A gallery that rewrites the masters — from the GiocondA.I. to Guernica — on the edge between instruction and chance.",
    },
  },
  {
    slug: 'short-stories',
    title: 'Racconti / Short stories',
    kicker: { it: 'Narrativa', en: 'Fiction' },
    excerpt: {
      it: "Una raccolta di racconti brevi scritti negli anni — tra concorsi letterari, notti insonni e idee che non volevano restare appunti. In italiano e in inglese.",
      en: "A collection of short stories written over the years — between literary contests, sleepless nights, and ideas that refused to stay notes. In Italian and English.",
    },
  },
];

const base = import.meta.env.BASE_URL;
const featCta = lang === 'it' ? 'Esplora il progetto' : 'Explore the project';
const featKicker = lang === 'it' ? 'In evidenza' : 'Featured';
---

<div class:list={["tq-feat", { compact }]} role="region" aria-label={featKicker}>
  <div class="tq-feat-copy">
    {featured.map((item, i) => (
      <div class="tq-feat-item" data-index={i}>
        <p class="kick">{featKicker} · {item.kicker[lang]}</p>
        <h2>{item.title}</h2>
        <p>{item.excerpt[lang]}</p>
        <a class="tq-feat-cta" href={`${base}projects/${item.slug}`}>
          {featCta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    ))}
    <div class="tq-dots">
      {featured.map((_, k) => (
        <button class={k === 0 ? "on" : ""} data-dot={k} aria-label={(featKicker) + ' ' + (k + 1)} />
      ))}
    </div>
  </div>
  {compact ? (
    <span class="tq-feat-num" aria-hidden="true">01</span>
  ) : (
    <div class="tq-feat-cover">
      <span class="tq-feat-ghostnum">{String(featured.length).padStart(2, "0")}</span>
    </div>
  )}
</div>

<script>
  const container = document.querySelector('.tq-feat');
  const items = container?.querySelectorAll('.tq-feat-item');
  const dots = container?.querySelectorAll('.tq-dots button');
  const numEl = container?.querySelector('.tq-feat-num');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  const total = items?.length || 0;

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function show(idx: number) {
    if (!items || !dots) return;
    items.forEach((el, i) => {
      (el as HTMLElement).style.display = i === idx ? '' : 'none';
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('on', i === idx);
    });
    if (numEl) numEl.textContent = String(idx + 1).padStart(2, '0');
    current = idx;
  }

  function startRotation() {
    if (prefersReduced || total < 2) return;
    timer = setInterval(() => {
      show((current + 1) % total);
    }, 5200);
  }

  function stopRotation() {
    clearInterval(timer);
  }

  dots?.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = parseInt((dot as HTMLElement).dataset.dot || '0', 10);
      show(idx);
      stopRotation();
      startRotation();
    });
  });

  container?.addEventListener('mouseenter', stopRotation);
  container?.addEventListener('mouseleave', startRotation);

  if (total > 0) show(0);
  startRotation();
</script>

<style>
  .tq-feat{position:relative;display:grid;grid-template-columns:1fr 230px;
    background:var(--color-surface);border:1px solid var(--color-border);
    border-radius:var(--radius-card);overflow:hidden;}
  .tq-feat-copy{padding:34px 36px;}
  .tq-feat-item{display:block;}
  .tq-feat .kick{font-family:var(--font-mono);font-size:.7rem;font-weight:600;text-transform:uppercase;
    letter-spacing:.14em;color:var(--color-accent);margin:0 0 14px;}
  .tq-feat h2{font-weight:600;letter-spacing:-.02em;color:var(--color-text-primary);
    font-size:2.1rem;line-height:1.08;margin:0 0 12px;}
  .tq-feat p{color:var(--color-text-secondary);font-size:1.1rem;line-height:1.6;margin:0 0 24px;max-width:62ch;}
  .tq-feat-cta{font-family:var(--font-mono);font-weight:600;text-transform:uppercase;
    letter-spacing:.06em;font-size:.72rem;display:inline-flex;align-items:center;gap:10px;
    background:none;color:var(--color-text-primary);border:1.5px solid var(--color-text-primary);
    padding:10px 18px;border-radius:var(--radius-chip);cursor:pointer;text-decoration:none;transition:.2s;}
  .tq-feat-cta:hover{background:var(--color-text-primary);color:var(--color-background);}
  .tq-feat-cover{position:relative;background:repeating-linear-gradient(135deg,var(--color-surface-alt) 0 10px,var(--color-border) 10px 20px);
    border-left:1px solid var(--color-border);display:flex;align-items:flex-end;justify-content:flex-end;padding:16px;}
  .tq-feat-ghostnum{font-family:var(--font-mono);font-weight:700;font-size:5.5rem;line-height:.8;
    color:var(--color-border);pointer-events:none;}
  .tq-dots{display:flex;gap:8px;margin-top:8px;}
  .tq-dots button{width:9px;height:9px;border-radius:999px;border:none;background:var(--color-border);
    cursor:pointer;padding:0;transition:.2s;}
  .tq-dots button.on{background:var(--color-accent);width:26px;}

  @media (max-width: 768px) {
    .tq-feat{grid-template-columns:1fr;}
    .tq-feat-cover{display:none;}
  }

  /* variante compatta per la fascia densa della home */
  .tq-feat.compact{grid-template-columns:1fr;}
  .tq-feat.compact .tq-feat-copy{position:relative;padding:30px 34px;min-height:300px;
    display:flex;flex-direction:column;}
  .tq-feat.compact .tq-feat-item{flex:1;}
  .tq-feat.compact .tq-dots{margin-top:auto;}
  .tq-feat.compact .tq-feat-num{position:absolute;top:24px;right:28px;
    font-family:var(--font-mono);font-weight:700;font-size:3.4rem;line-height:.8;
    color:var(--color-border);pointer-events:none;}
</style>
