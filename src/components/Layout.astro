---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

import Header from './Header.astro';
import Sidebar from './Sidebar.astro';
import Footer from './Footer.astro';
import SEO from './SEO.astro';

export interface Props {
  title: string;
  description?: string;
  showSidebar?: boolean;
  /** Drops the container's vertical padding and skips the long Footer —
   *  for pages (like the home "bivio") that draw their own edge-to-edge
   *  layout and footer strip. */
  fullHeight?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  canonical?: string;
  lang?: 'en' | 'it';
  /** URL of the real translation of the current page in the other
   *  language, if one exists. Overrides Header's naive path-swap toggle. */
  translatedUrl?: string;
  /** hreflang alternates, only set when a real (non-fallback) translation
   *  exists for the current page. */
  alternateUrls?: { lang: string; url: string }[];
  /** Keeps the page out of search results and out of the sitemap. */
  noindex?: boolean;
  /** Language of the main content, when it differs from `lang`. */
  contentLang?: string;
}

const { title, description, showSidebar = false, fullHeight = false, image, type, publishedTime, canonical, translatedUrl, alternateUrls, noindex, contentLang } = Astro.props;

 // Determine language from URL, fallback to prop or 'en'
const lang: 'en' | 'it' = (Astro.props.lang === 'en' || Astro.props.lang === 'it') 
  ? Astro.props.lang 
  : (Astro.url.pathname.startsWith('/en/') ? 'en' : 'it');

---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme-init.js"></script>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      canonical={canonical}
      alternateUrls={alternateUrls}
      noindex={noindex}
      lang={lang}
      contentLang={contentLang}
    />
  </head>
  <body>
    <div class="site-wrapper">
      <Header lang={lang} translatedUrl={translatedUrl} />
      
      <main class="main-content" class:list={{ 'with-sidebar': showSidebar, 'is-full': fullHeight }}>
        {showSidebar && (
          <aside class="sidebar">
            <Sidebar lang={lang} />
          </aside>
        )}

        <div class="content">
          <slot />
        </div>
      </main>

      {!fullHeight && <Footer />}
    </div>
  </body>
</html>

<style>
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    width: 100%;
  }

  .main-content.with-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--grid-unit) * 4);
  }

  /* fullHeight pages (the home "bivio") fill the space left by the header
     with no scroll: main-content is already a flex:1 item, so stretching
     it and its content wrapper into a column lets the slotted layout
     claim the exact remaining viewport height without hardcoding the
     header's pixel height anywhere. */
  .main-content.is-full {
    display: flex;
    flex-direction: column;
  }

  .main-content.is-full .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .content {
    min-width: 0;
    padding: calc(var(--grid-unit) * 3) 0;
  }

  .sidebar {
    order: -1;
    padding-top: calc(var(--grid-unit) * 3);
  }

  @media (min-width: 1024px) {
    .main-content.with-sidebar {
      grid-template-columns: var(--sidebar-width) 1fr;
    }
    
    .sidebar {
      order: 0;
      padding-top: calc(var(--grid-unit) * 3);
    }
  }
</style>