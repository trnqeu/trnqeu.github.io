---
// Renders its slot as a reply from an LLM, in the style of a chat app.
interface Props {
    name?: string;
    thought?: string;
}

const { name = 'Commissario Gipiti', thought } = Astro.props;
---
<div class="llm-response">
    <div class="header">
        <span class="avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z" /></svg>
        </span>
        <span class="name">{name}</span>
    </div>
    {thought && (
        <div class="thought">
            {thought}
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </div>
    )}
    <div class="content">
        <slot />
    </div>
    <div class="actions" aria-hidden="true">
        <span class="action">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
        </span>
        <span class="action">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v11M15 5.9L14 10h5.8a2 2 0 0 1 2 2.4l-1.4 7a2 2 0 0 1-2 1.6H7V10l4-8a3 3 0 0 1 4 3.9z" /></svg>
        </span>
        <span class="action">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V3M9 18.1L10 14H4.2a2 2 0 0 1-2-2.4l1.4-7a2 2 0 0 1 2-1.6H17v11l-4 8a3 3 0 0 1-4-3.9z" /></svg>
        </span>
        <span class="action">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16M3 21v-5h5" /></svg>
        </span>
    </div>
</div>

<style>
    .llm-response {
        max-width: 640px;
        margin: 32px auto;
    }

    .header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        color: var(--color-accent-contrast);
        background: var(--color-accent);
    }

    .name {
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .thought {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin: 0 0 8px 38px;
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .content {
        margin-left: 38px;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-text-primary);
    }

    .content :global(p) {
        margin: 0 0 12px;
    }

    .content :global(p:last-child) {
        margin-bottom: 0;
    }

    .actions {
        display: flex;
        gap: 4px;
        margin: 12px 0 0 32px;
    }

    .action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        color: var(--color-text-muted);
    }

    @media (max-width: 480px) {
        .thought,
        .content {
            margin-left: 0;
        }

        .actions {
            margin-left: -6px;
        }
    }
</style>
