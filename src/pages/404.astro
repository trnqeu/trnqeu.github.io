---
import Layout from '../components/Layout.astro';
---

<Layout title="Pagina non trovata" description="Questa pagina non esiste o è stata spostata." lang="it" translatedUrl="/en/" noindex>
  <div class="not-found">
    <header class="page-header">
      <p class="kicker">404</p>
      <h1 class="page-title">Pagina non trovata</h1>
      <p class="page-description">
        Questa pagina non esiste o è stata spostata. Puoi ripartire da qui:
      </p>
    </header>

    <ul class="links">
      <li><a href="/">Home</a></li>
      <li><a href="/writing/">Scritti</a></li>
      <li><a href="/projects/">Progetti</a></li>
    </ul>

    <p class="page-description" lang="en">
      Page not found. Try the <a href="/en/">English home page</a>, the
      <a href="/en/writing/">writings</a> or the <a href="/en/projects/">projects</a>.
    </p>
  </div>
</Layout>

<style>
  .not-found {
    max-width: 800px;
    margin: 0 auto;
    padding: 44px 0 60px;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .page-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    border-top: 2px solid var(--color-border-strong);
  }

  .links li {
    border-bottom: 1px solid var(--color-border);
  }

  .links a {
    display: block;
    padding: 14px 0;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .links a:hover,
  .links a:focus {
    color: var(--color-accent);
  }
</style>
