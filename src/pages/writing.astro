---
import Layout from '../components/Layout.astro';
import { localize, slugFromFile } from '../utils/i18n';

const lang: 'it' = 'it';
const base = import.meta.env.BASE_URL;

const mdPostsGlob = import.meta.glob('../content/ideas/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../content/ideas/*.mdx', { eager: true });
const murderHePromptedPostsGlob = import.meta.glob('../content/murderheprompted/*.md', { eager: true });
const murderHePromptedMdxPostsGlob = import.meta.glob('../content/murderheprompted/*.mdx', { eager: true });
const shortStoriesPostsGlob = import.meta.glob('../content/shortstories/*.md', { eager: true });
const shortStoriesMdxPostsGlob = import.meta.glob('../content/shortstories/*.mdx', { eager: true });
const promptsOnCanvasPostsGlob = import.meta.glob('../content/promptsoncanvas/*.md', { eager: true });
const promptsOnCanvasMdxPostsGlob = import.meta.glob('../content/promptsoncanvas/*.mdx', { eager: true });
const allPosts = [
  ...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob),
  ...Object.values(murderHePromptedPostsGlob), ...Object.values(murderHePromptedMdxPostsGlob),
  ...Object.values(shortStoriesPostsGlob), ...Object.values(shortStoriesMdxPostsGlob),
  ...Object.values(promptsOnCanvasPostsGlob), ...Object.values(promptsOnCanvasMdxPostsGlob),
] as any[];

const sortedPosts = localize(allPosts, lang)
  .map(({ post, isFallback }) => ({ ...post, isFallback }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const allCategories = Array.from(
  new Set(sortedPosts.flatMap((p: any) => p.frontmatter.categories || []))
).sort((a, b) => a.localeCompare(b));

const i18n = {
  it: {
    kicker: 'Indice',
    title: 'Archivio',
    description: 'Tutti gli scritti, in ordine cronologico.',
    searchPlaceholder: 'Cerca tra gli scritti…',
    filterAll: 'Tutti',
    notTranslatedNote: 'non ancora tradotti',
    months: ['gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre'],
  },
};
const dict = i18n[lang];

// frontmatter `date` is a bare "YYYY-MM-DD" string when quoted in the
// source, but an unquoted `date: 2025-10-29` gets YAML-parsed to a Date and
// then serialized as a full ISO string ("…T00:00:00.000Z") — appending
// 'T00:00:00' to that (as if it were still a bare date) breaks parsing and
// yields "Invalid Date". Only append it when there's no time part yet.
function fmtDate(input: string | Date): string {
  const iso = input instanceof Date ? input.toISOString() : input;
  const d = new Date(iso.includes('T') ? iso : `${iso}T00:00:00`);
  const m = dict.months[d.getMonth()];
  return `${d.getDate()} ${m} ${d.getFullYear()}`;
}

function postHref(post: any): string {
  const dir = post.file.includes('/murderheprompted/') ? 'murderheprompted/'
    : post.file.includes('/shortstories/') ? 'shortstories/'
    : post.file.includes('/promptsoncanvas/') ? 'promptsoncanvas/'
    : 'ideas/';
  return `${base}${dir}${slugFromFile(post.file)}`;
}
---

<Layout title={`Trnq.eu: ${dict.title}`} description={dict.description} showSidebar={false} lang={lang}>
  <div class="tq-archive">
    <header class="page-header">
      <p class="kicker">{dict.kicker}</p>
      <h1 class="page-title">{dict.title}</h1>
      <p class="page-description">{dict.description}</p>
    </header>

    <div class="tq-explore">
      <div class="tq-searchbox">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" class="tq-search-input" id="tq-search-input" placeholder={dict.searchPlaceholder} autocomplete="off" />
      </div>
      <div class="tq-chips" id="tq-chips">
        <button class="tq-chip on" data-cat="">{dict.filterAll}</button>
        {allCategories.map(c => (
          <button class="tq-chip" data-cat={c.toLowerCase()}>{c}</button>
        ))}
      </div>
      <span class="tq-langnote">▸ <b>{dict.notTranslatedNote}</b></span>
    </div>

    <div class="tq-rowlist" id="tq-rowlist">
      {sortedPosts.map((post: any) => {
        const fm = post.frontmatter;
        const cats = fm.categories || [];
        return (
          <a class={"tq-row" + (post.isFallback ? " fallback" : "")} href={postHref(post)}
            data-title={fm.title.toLowerCase()}
            data-cats={(cats as string[]).join(' ').toLowerCase()}
            data-lang={fm.lang}>
            <span class="rdate">{fmtDate(fm.date)}</span>
            <span class="rtitle">{fm.title}</span>
            <span class="rtags">
              {post.isFallback && <span class="tq-langbadge filled">{fm.lang}</span>}
              {cats.length > 0 && <span class="tq-cat">{cats[0]}</span>}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('tq-search-input') as HTMLInputElement | null;
  const chips = document.querySelectorAll('#tq-chips .tq-chip');
  const rows = document.querySelectorAll('#tq-rowlist .tq-row');

  let activeCat = '';

  function filterRows() {
    const q = input?.value.toLowerCase().trim() || '';
    rows.forEach((row) => {
      const title = (row as HTMLElement).dataset.title || '';
      const cats = (row as HTMLElement).dataset.cats || '';
      const matchesSearch = !q || title.includes(q) || cats.includes(q);
      const matchesCat = !activeCat || cats.includes(activeCat);
      (row as HTMLElement).hidden = !(matchesSearch && matchesCat);
    });
  }

  input?.addEventListener('input', filterRows);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('on'));
      chip.classList.add('on');
      activeCat = (chip as HTMLElement).dataset.cat || '';
      filterRows();
    });
  });
</script>

<style>
  .tq-archive{ max-width: 900px; margin: 0 auto; padding: 44px 0 60px; }

  .page-header{ margin-bottom: 32px; }
  .kicker{
    font-family:var(--font-mono); font-size:.68rem; letter-spacing:.16em;
    text-transform:uppercase; color:var(--color-accent); margin:0 0 14px;
  }
  .page-title{
    font-size:clamp(2.4rem, 5vw, 3.4rem); font-weight:600;
    letter-spacing:-.03em; margin-bottom:10px;
  }
  .page-description{
    font-size:1.05rem; line-height:1.6; color:var(--color-text-secondary);
    max-width:560px; margin:0;
  }

  .tq-explore{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;}
  .tq-searchbox{position:relative;flex:1;min-width:220px;}
  .tq-searchbox input{width:100%;font-family:var(--font-body);font-size:1rem;color:var(--color-text-primary);
    background:var(--color-surface);border:1px solid var(--color-border);border-radius:6px;
    padding:10px 14px 10px 40px;outline:none;transition:.18s;}
  .tq-searchbox input:focus{border-color:var(--color-accent);}
  .tq-searchbox input::placeholder{color:var(--color-text-muted);}
  .tq-searchbox svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);}
  .tq-chips{display:flex;gap:7px;flex-wrap:wrap;}
  .tq-chip{font-family:var(--font-mono);font-size:.68rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
    border:1px solid var(--color-border);background:var(--color-background);color:var(--color-text-secondary);
    border-radius:var(--radius-chip);padding:6px 12px;cursor:pointer;transition:.16s;}
  .tq-chip:hover{border-color:var(--color-accent);color:var(--color-accent);}
  .tq-chip.on{background:var(--color-accent);color:var(--color-accent-contrast);border-color:var(--color-accent);}
  .tq-langnote{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.04em;color:var(--color-text-muted);
    display:inline-flex;align-items:center;gap:7px;}
  .tq-langnote b{color:var(--color-accent);}

  .tq-rowlist{display:flex;flex-direction:column;border-top:2px solid var(--color-border-strong);}
  .tq-row{display:grid;grid-template-columns:130px 1fr auto;gap:20px;align-items:center;
    padding:16px 6px;border-bottom:1px solid var(--color-border);text-decoration:none;
    cursor:pointer;transition:.18s;}
  .tq-row:hover{background:var(--color-surface);padding-left:12px;}
  .tq-row .rdate{font-family:var(--font-mono);font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;color:var(--color-text-muted);}
  .tq-row .rtitle{font-weight:600;font-size:1.1rem;color:var(--color-text-primary);}
  .tq-row:hover .rtitle{color:var(--color-accent);}
  .tq-row.fallback .rtitle{border-left:3px dashed var(--color-text-muted);padding-left:12px;}
  .tq-row .rtags{display:flex;gap:7px;align-items:center;}
  .tq-langbadge{font-family:var(--font-mono);font-size:.62rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;
    color:var(--color-accent);border:1px solid var(--color-border);border-radius:var(--radius-badge);padding:2px 6px;}
  .tq-langbadge.filled{background:var(--color-accent);color:var(--color-accent-contrast);border-color:var(--color-accent);}
  .tq-cat{background:var(--color-surface-alt);color:var(--color-text-secondary);font-family:var(--font-mono);
    font-size:.62rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;padding:2px 6px;border-radius:var(--radius-badge);}

  @media (max-width:768px){
    .tq-row{grid-template-columns:1fr;gap:8px;}
    .tq-row .rdate{font-size:.7rem;}
    .tq-row .rtitle{font-size:1.05rem;}
  }
</style>
