---
import Layout from "../../components/Layout.astro";
---

<Layout
    title="Admin - Catalogazione Libri"
    description="Pannello di amministrazione per il catalogo libri."
>
    <main class="admin-page">
        <!-- Sezione Login -->
        <section id="loginSection" class="auth-section">
            <div class="auth-card">
                <h1 class="auth-title">Accesso Catalogo</h1>
                <p class="auth-subtitle">
                    Inserisci la password per gestire il database
                </p>
                <div class="auth-form">
                    <input
                        type="password"
                        id="adminPassword"
                        class="auth-input"
                        placeholder="Password admin"
                    />
                    <button id="loginBtn" class="btn btn-primary w-full"
                        >Entra</button
                    >
                </div>
            </div>
        </section>

        <!-- Sezione Admin Content (Nascosta inizialmente) -->
        <section id="adminContent" class="admin-content hidden">
            <header class="admin-header">
                <div class="admin-header-title">
                    <span class="admin-tag">Pannello Admin</span>
                    <h2>Aggiungi Libro</h2>
                </div>
                <button id="logoutBtn" class="btn btn-secondary">Esci</button>
            </header>

            <div class="mode-tabs">
                <button id="modeAddBtn" class="btn btn-secondary mode-tab active"
                    >Aggiungi Libro</button
                >
                <button id="modeEditBtn" class="btn btn-secondary mode-tab"
                    >Modifica Libro</button
                >
            </div>

            <div id="addSection" class="search-section">
                <div class="search-box">
                    <select
                        id="searchType"
                        class="form-select"
                        style="max-width: 120px;"
                    >
                        <option value="intitle">Titolo</option>
                        <option value="inauthor">Autore</option>
                        <option value="isbn">ISBN</option>
                        <option value="none">Generico</option>
                    </select>
                    <input
                        type="text"
                        id="searchQuery"
                        class="search-input"
                        placeholder="Cerca per Titolo o ISBN..."
                    />
                    <button id="searchBtn" class="btn btn-primary">Cerca</button
                    >
                    <button id="manualBtn" class="btn btn-secondary ml-2"
                        >Manuale</button
                    >
                </div>
                <p class="search-hint">
                    Cerca su Google Books oppure inserisci i dati manualmente
                </p>
            </div>

            <div id="editSection" class="search-section hidden">
                <div class="search-box">
                    <input
                        type="text"
                        id="editSearchQuery"
                        class="search-input"
                        placeholder="Cerca nel catalogo per titolo o autore..."
                    />
                    <button id="editSearchBtn" class="btn btn-primary"
                        >Cerca</button
                    >
                </div>
                <p class="search-hint">
                    Cerca un libro già presente nel catalogo per modificarlo
                </p>
                <div id="editResults" class="edit-results"></div>
            </div>

            <div id="bookFormContainer" class="hidden">
                <hr class="red-rule" />
                <div class="book-form-card">
                    <h3 class="form-title" id="formHeaderTitle">
                        Dettagli Libro
                    </h3>

                    <div class="form-grid">
                        <div class="form-preview">
                            <span class="preview-label">Copertina</span>
                            <div class="preview-container">
                                <img
                                    id="formCoverPreview"
                                    class="hidden"
                                    alt="Cover"
                                />
                                <div id="noCover" class="no-cover">
                                    Nessuna anteprima
                                </div>
                            </div>
                        </div>

                        <div class="form-fields">
                            <div class="field-group">
                                <label for="formTitle">Titolo</label>
                                <input
                                    type="text"
                                    id="formTitle"
                                    class="form-input"
                                />
                            </div>

                            <div class="field-group">
                                <label for="formAuthor">Autore</label>
                                <input
                                    type="text"
                                    id="formAuthor"
                                    class="form-input"
                                />
                            </div>

                            <div class="field-row">
                                <div class="field-group">
                                    <label for="formPublisher">Editore</label>
                                    <input
                                        type="text"
                                        id="formPublisher"
                                        class="form-input"
                                    />
                                </div>
                                <div class="field-group small">
                                    <label for="formLanguage">Lingua</label>
                                    <input
                                        type="text"
                                        id="formLanguage"
                                        class="form-input text-center"
                                    />
                                </div>
                                <div class="field-group small">
                                    <label for="formFormat">Formato</label>
                                    <select id="formFormat" class="form-select">
                                        <option value="Ebook">Ebook</option>
                                        <option value="Cartaceo"
                                            >Cartaceo</option
                                        >
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="field-group full-width">
                        <label for="formDescription">Descrizione</label>
                        <textarea
                            id="formDescription"
                            rows="8"
                            class="form-textarea"></textarea>
                    </div>

                    <div class="field-group opacity-50">
                        <label for="formCoverUrl">URL Immagine</label>
                        <input
                            type="text"
                            id="formCoverUrl"
                            class="form-input font-mono text-xs"
                        />
                    </div>

                    <div class="form-actions">
                        <button id="saveBtn" class="btn btn-primary btn-large">
                            Salva nel Database
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <style>
        .admin-page {
            max-width: 900px;
            margin: 0 auto;
            padding: calc(var(--grid-unit) * 4) 0;
            min-height: 70vh;
        }

        /* Auth Section */
        .auth-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: calc(var(--grid-unit) * 8) 0;
        }

        .auth-card {
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: calc(var(--grid-unit) * 6);
            border-radius: 8px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .auth-title {
            font-family: var(--font-heading-primary);
            font-size: 2.5rem;
            color: var(--color-accent);
            margin-bottom: calc(var(--grid-unit));
            letter-spacing: 0.1em;
        }

        .auth-subtitle {
            font-family: var(--font-heading-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
            color: var(--color-text-muted);
            margin-bottom: calc(var(--grid-unit) * 4);
            letter-spacing: 0.1em;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: calc(var(--grid-unit) * 2);
        }

        .auth-input {
            width: 100%;
            padding: calc(var(--grid-unit) * 1.5);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            background-color: var(--color-background);
            color: var(--color-text-primary);
            font-family: var(--font-body);
            text-align: center;
            font-size: 1.1rem;
        }

        /* Admin Content */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: calc(var(--grid-unit) * 6);
            border-bottom: 2px solid var(--color-text-primary);
            padding-bottom: calc(var(--grid-unit) * 2);
        }

        .admin-tag {
            background-color: var(--color-accent);
            color: white;
            padding: 2px 8px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: calc(var(--grid-unit));
            display: inline-block;
        }

        .admin-header-title h2 {
            margin-bottom: 0;
        }

        /* Mode Tabs */
        .mode-tabs {
            display: flex;
            gap: calc(var(--grid-unit));
            margin-bottom: calc(var(--grid-unit) * 4);
        }

        .mode-tab {
            opacity: 0.5;
        }

        .mode-tab.active {
            opacity: 1;
            background-color: var(--color-text-primary);
            color: var(--color-background);
        }

        /* Search Section */
        .search-section {
            margin-bottom: calc(var(--grid-unit) * 6);
        }

        /* Edit results */
        /* :global() because these elements are injected at runtime via
           innerHTML (see loadBookForEdit / editSearchBtn below) — Astro's
           compile-time CSS scoping never sees them, so unscoped rules here
           would silently not apply. Same pattern as eblioteque.astro. */
        :global(.edit-results) {
            margin-top: calc(var(--grid-unit) * 3);
            display: flex;
            flex-direction: column;
            gap: calc(var(--grid-unit));
        }

        :global(.edit-result-item) {
            display: flex;
            align-items: center;
            gap: calc(var(--grid-unit) * 2);
            padding: calc(var(--grid-unit) * 1.5);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            background-color: var(--color-surface);
            cursor: pointer;
            text-align: left;
            width: 100%;
            font-family: var(--font-body);
            color: var(--color-text-primary);
        }

        :global(.edit-result-item:hover) {
            border-color: var(--color-accent);
        }

        :global(.edit-result-cover) {
            width: 36px;
            height: 54px;
            object-fit: cover;
            flex-shrink: 0;
            background-color: var(--color-background);
        }

        :global(.edit-result-info) {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        :global(.edit-result-title) {
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        :global(.edit-result-author) {
            font-size: 0.85rem;
            color: var(--color-text-muted);
        }

        .search-box {
            display: flex;
            gap: calc(var(--grid-unit));
        }

        .ml-2 {
            margin-left: calc(var(--grid-unit));
        }

        .search-input {
            flex: 1;
            padding: calc(var(--grid-unit) * 2);
            border: 2px solid var(--color-border);
            border-radius: 4px;
            font-size: 1.1rem;
            color: var(--color-text-primary);
            color: var(--color-text-primary);
            background-color: var(--color-background);
        }

        .search-hint {
            font-size: 0.85rem;
            color: var(--color-text-muted);
            margin-top: calc(var(--grid-unit));
            font-style: italic;
        }

        /* Form Card */
        .book-form-card {
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: calc(var(--grid-unit) * 4);
            border-radius: 8px;
            margin-top: calc(var(--grid-unit) * 4);
        }

        .form-title {
            color: var(--color-accent);
            border-bottom: 1px solid var(--color-border);
            padding-bottom: calc(var(--grid-unit) * 2);
            margin-bottom: calc(var(--grid-unit) * 4);
            font-size: 1.5rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: calc(var(--grid-unit) * 4);
            margin-bottom: calc(var(--grid-unit) * 4);
        }

        @media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .form-preview {
                text-align: center;
            }
        }

        .preview-label {
            display: block;
            font-family: var(--font-heading-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--color-text-muted);
            margin-bottom: calc(var(--grid-unit));
        }

        .preview-container {
            border: 1px solid var(--color-border);
            background-color: var(--color-background);
            min-height: 240px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 4px;
        }

        .no-cover {
            font-size: 0.8rem;
            color: var(--color-text-muted);
            text-transform: uppercase;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: calc(var(--grid-unit) / 2);
            margin-bottom: calc(var(--grid-unit) * 2);
        }

        .field-row {
            display: flex;
            gap: calc(var(--grid-unit) * 2);
            flex-wrap: wrap;
        }

        .field-group label {
            font-family: var(--font-heading-secondary);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--color-text-secondary);
            letter-spacing: 0.05em;
        }

        .form-input,
        .form-select,
        .form-textarea {
            padding: calc(var(--grid-unit) * 1.5);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            background-color: var(--color-background);
            color: var(--color-text-primary);
            font-family: var(--font-body);
            width: 100%;
        }

        .form-textarea {
            resize: vertical;
        }

        .field-group.small {
            flex: 1;
            min-width: 100px;
        }

        .form-actions {
            margin-top: calc(var(--grid-unit) * 4);
            text-align: right;
        }

        /* Common Elements */
        .red-rule {
            border: none;
            height: 4px;
            background-color: var(--color-accent);
            margin: calc(var(--grid-unit) * 4) 0;
            width: 100%;
        }

        .btn {
            font-family: var(--font-heading-secondary);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
            border-radius: 4px;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            display: inline-block;
        }

        .btn-primary {
            background-color: var(--color-accent);
            color: white;
        }

        .btn-primary:hover {
            filter: brightness(1.2);
            transform: translateY(-2px);
        }

        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--color-text-primary);
            color: var(--color-text-primary);
            padding: calc(var(--grid-unit) * 1) calc(var(--grid-unit) * 2);
            font-size: 0.8rem;
        }

        .btn-secondary:hover {
            background-color: var(--color-text-primary);
            color: var(--color-background);
        }

        .btn-large {
            padding: calc(var(--grid-unit) * 2) calc(var(--grid-unit) * 6);
            font-size: 1.1rem;
        }

        .hidden {
            display: none !important;
        }
    </style>

    <script>
        // --- ELEMENTI UI ---
        const loginSection = document.getElementById("loginSection");
        const adminContent = document.getElementById("adminContent");
        const adminPassword = document.getElementById(
            "adminPassword",
        ) as HTMLInputElement;
        const loginBtn = document.getElementById("loginBtn");
        const logoutBtn = document.getElementById("logoutBtn");

        const searchBtn = document.getElementById("searchBtn");
        const manualBtn = document.getElementById("manualBtn");
        const searchQuery = document.getElementById(
            "searchQuery",
        ) as HTMLInputElement;
        const bookFormContainer = document.getElementById("bookFormContainer");
        const formHeaderTitle = document.getElementById("formHeaderTitle");

        const modeAddBtn = document.getElementById("modeAddBtn");
        const modeEditBtn = document.getElementById("modeEditBtn");
        const addSection = document.getElementById("addSection");
        const editSection = document.getElementById("editSection");
        const editSearchBtn = document.getElementById("editSearchBtn");
        const editSearchQuery = document.getElementById(
            "editSearchQuery",
        ) as HTMLInputElement;
        const editResults = document.getElementById("editResults");

        // id of the book currently being edited; null while adding a new one
        let editingBookId: string | null = null;

        const fTitle = document.getElementById("formTitle") as HTMLInputElement;
        const fAuthor = document.getElementById(
            "formAuthor",
        ) as HTMLInputElement;
        const fPublisher = document.getElementById(
            "formPublisher",
        ) as HTMLInputElement;
        const fLanguage = document.getElementById(
            "formLanguage",
        ) as HTMLInputElement;
        const fFormat = document.getElementById(
            "formFormat",
        ) as HTMLSelectElement;
        const fDescription = document.getElementById(
            "formDescription",
        ) as HTMLTextAreaElement;
        const fCoverUrl = document.getElementById(
            "formCoverUrl",
        ) as HTMLInputElement;
        const fCoverPreview = document.getElementById(
            "formCoverPreview",
        ) as HTMLImageElement;
        const noCover = document.getElementById("noCover");
        const saveBtn = document.getElementById("saveBtn") as HTMLButtonElement;

        const API_BASE_URL = "https://book-api.trnq.eu";

        // Escape untrusted book data (sourced from the external
        // book-api.trnq.eu) before interpolating it into innerHTML, to
        // prevent stored XSS — same pattern used on the public catalogue.
        function escapeHtml(value: unknown): string {
            return String(value ?? "").replace(
                /[&<>"']/g,
                (char) =>
                    ({
                        "&": "&amp;",
                        "<": "&lt;",
                        ">": "&gt;",
                        '"': "&quot;",
                        "'": "&#39;",
                    })[char] as string,
            );
        }

        // --- MODALITÀ: AGGIUNGI / MODIFICA ---
        const switchToAddMode = () => {
            editingBookId = null;
            modeAddBtn?.classList.add("active");
            modeEditBtn?.classList.remove("active");
            addSection?.classList.remove("hidden");
            editSection?.classList.add("hidden");
            bookFormContainer?.classList.add("hidden");
            if (formHeaderTitle) formHeaderTitle.textContent = "Dettagli Libro";
            if (saveBtn) saveBtn.textContent = "Salva nel Database";
        };

        const switchToEditMode = () => {
            editingBookId = null;
            modeAddBtn?.classList.remove("active");
            modeEditBtn?.classList.add("active");
            addSection?.classList.add("hidden");
            editSection?.classList.remove("hidden");
            bookFormContainer?.classList.add("hidden");
        };

        modeAddBtn?.addEventListener("click", switchToAddMode);
        modeEditBtn?.addEventListener("click", switchToEditMode);

        // --- LOGICA RICERCA LIBRO DA MODIFICARE ---
        editSearchBtn?.addEventListener("click", async () => {
            const q = editSearchQuery.value.trim();
            if (!q || !editResults) return;

            editResults.innerHTML = "<p>Ricerca...</p>";

            try {
                const url = `${API_BASE_URL}/api/catalog?limit=15&search=${encodeURIComponent(q)}`;
                const res = await fetch(url);
                if (!res.ok) throw new Error("API Error");
                const data = await res.json();
                const books = data.data || [];

                if (!books.length) {
                    editResults.innerHTML = "<p>Nessun libro trovato.</p>";
                    return;
                }

                editResults.innerHTML = "";
                books.forEach((book: any) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "edit-result-item";
                    btn.innerHTML = `
                        <img class="edit-result-cover" src="${escapeHtml(book.coverUrl || "/placeholder-book.png")}" alt="" onerror="this.src='/placeholder-book.png';">
                        <span class="edit-result-info">
                            <span class="edit-result-title">${escapeHtml(book.title)}</span>
                            <span class="edit-result-author">${escapeHtml(book.author)}</span>
                        </span>
                    `;
                    btn.addEventListener("click", () => loadBookForEdit(book.id));
                    editResults.appendChild(btn);
                });
            } catch (err) {
                console.error("Errore ricerca catalogo:", err);
                editResults.innerHTML =
                    "<p>Errore durante la ricerca nel catalogo.</p>";
            }
        });

        async function loadBookForEdit(id: string) {
            try {
                const res = await fetch(`${API_BASE_URL}/app/books/${id}`);
                if (!res.ok) throw new Error("not found");
                const book = await res.json();

                editingBookId = id;

                fTitle.value = book.title || "";
                fAuthor.value = book.author || "";
                fPublisher.value = book.publishingHouse ?? book.publisher ?? "";
                fLanguage.value = book.language || "";
                fFormat.value = book.format || "Ebook";
                fDescription.value = book.description || "";
                fCoverUrl.value = book.coverUrl || "";

                if (book.coverUrl) {
                    fCoverPreview.src = book.coverUrl;
                    fCoverPreview.classList.remove("hidden");
                    if (noCover) noCover.classList.add("hidden");
                } else {
                    fCoverPreview.classList.add("hidden");
                    fCoverPreview.removeAttribute("src");
                    if (noCover) noCover.classList.remove("hidden");
                }

                if (formHeaderTitle)
                    formHeaderTitle.textContent = "Modifica Libro";
                if (saveBtn) saveBtn.textContent = "Salva Modifiche";

                bookFormContainer?.classList.remove("hidden");
                bookFormContainer?.scrollIntoView({ behavior: "smooth" });
            } catch (err) {
                console.error("Errore caricamento libro:", err);
                alert("Impossibile caricare il libro selezionato.");
            }
        }

        // --- GESTIONE ACCESSO ---
        // Client-side session expiry: mitigation while a real server-side
        // expiry (httpOnly cookie) is out of reach — book-api.trnq.eu is an
        // external backend outside this repo. The token itself may remain
        // valid server-side past this point; this only forces a local
        // re-login, shrinking the window an XSS-stolen token stays useful.
        const SESSION_MAX_MS = 8 * 60 * 60 * 1000; // 8 hours

        const isSessionExpired = () => {
            const ts = localStorage.getItem("admin_token_ts");
            // No timestamp (e.g. a token set before this check existed) is
            // treated as expired, so it can't linger unbounded.
            if (!ts) return true;
            return Date.now() - Number(ts) > SESSION_MAX_MS;
        };

        const clearSession = () => {
            localStorage.removeItem("admin_token");
            localStorage.removeItem("admin_token_ts");
        };

        const updateUI = () => {
            if (isSessionExpired()) clearSession();
            const token = localStorage.getItem("admin_token");
            if (token) {
                loginSection?.classList.add("hidden");
                adminContent?.classList.remove("hidden");
            } else {
                loginSection?.classList.remove("hidden");
                adminContent?.classList.add("hidden");
            }
        };

        updateUI(); // Esegui al caricamento della pagina

        loginBtn?.addEventListener("click", async () => {
            const password = adminPassword.value;
            if (!password) return;

            try {
                const res = await fetch("https://book-api.trnq.eu/api/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ password }),
                });
                const data = await res.json();
                if (data.token) {
                    localStorage.setItem("admin_token", data.token);
                    localStorage.setItem("admin_token_ts", String(Date.now()));
                    updateUI();
                } else {
                    alert("Password Errata");
                }
            } catch (e) {
                alert("Server non raggiungibile");
            }
        });

        logoutBtn?.addEventListener("click", () => {
            clearSession();
            updateUI();
        });

        const handleAuthExpired = () => {
            clearSession();
            updateUI();
            alert("Sessione scaduta. Effettua di nuovo il login.");
        };

        // --- LOGICA MANUALE ---
        manualBtn?.addEventListener("click", () => {
            editingBookId = null;
            if (formHeaderTitle) formHeaderTitle.textContent = "Dettagli Libro";
            if (saveBtn) saveBtn.textContent = "Salva nel Database";

            // Pulisce i campi
            fTitle.value = "";
            fAuthor.value = "";
            fPublisher.value = "";
            fLanguage.value = "it";
            fDescription.value = "";
            fCoverUrl.value = "";

            // Resetta anteprima
            fCoverPreview.classList.add("hidden");
            fCoverPreview.removeAttribute("src");
            if (noCover) noCover.classList.remove("hidden");

            // Mostra il form
            bookFormContainer?.classList.remove("hidden");
            bookFormContainer?.scrollIntoView({ behavior: "smooth" });
        });

        // --- LOGICA RICERCA ---
        searchBtn?.addEventListener("click", async () => {
            const q = searchQuery.value;
            const type = (
                document.getElementById("searchType") as HTMLSelectElement
            ).value;
            let finalQuery = q;
            if (type !== "none" && !q.includes(":")) {
                finalQuery = `${type}:${q}`;
            }
            if (!q) return;

            editingBookId = null;
            if (formHeaderTitle) formHeaderTitle.textContent = "Dettagli Libro";
            if (saveBtn) saveBtn.textContent = "Salva nel Database";

            searchBtn.textContent = "Ricerca...";
            searchBtn.classList.add("opacity-50");

            try {
                const apiKey = import.meta.env.PUBLIC_GOOGLE_BOOKS_API_KEY;
                const url = `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(finalQuery)}${apiKey ? `&key=${apiKey}` : ""}`;
                const res = await fetch(url);
                const data = await res.json();
                if (!data.items) {
                    alert("Nessun libro trovato");
                    return;
                }

                const info = data.items[0].volumeInfo;
                fTitle.value = info.title || "";
                fAuthor.value = info.authors?.join(", ") || "";
                fPublisher.value = info.publisher || "";
                fLanguage.value = info.language || "it";
                fDescription.value = info.description || "";

                const thumb = info.imageLinks?.thumbnail
                    ? info.imageLinks.thumbnail.replace("http:", "https:")
                    : "";
                fCoverUrl.value = thumb;
                if (thumb) {
                    fCoverPreview.src = thumb;
                    fCoverPreview.classList.remove("hidden");
                    if (noCover) noCover.classList.add("hidden");
                } else {
                    fCoverPreview.classList.add("hidden");
                    fCoverPreview.removeAttribute("src");
                    if (noCover) noCover.classList.remove("hidden");
                }

                bookFormContainer?.classList.remove("hidden");
                bookFormContainer?.scrollIntoView({ behavior: "smooth" });
            } catch (err) {
                console.error("Errore ricerca:", err);
            } finally {
                searchBtn.textContent = "Cerca";
                searchBtn.classList.remove("opacity-50");
            }
        });

        // --- LOGICA SALVATAGGIO ---
        saveBtn?.addEventListener("click", async () => {
            if (isSessionExpired()) {
                handleAuthExpired();
                return;
            }
            const token = localStorage.getItem("admin_token");
            if (!token) return;

            const bookToSave = {
                title: fTitle.value,
                author: fAuthor.value,
                description: fDescription.value,
                coverUrl: fCoverUrl.value,
                publishingHouse: fPublisher.value,
                language: fLanguage.value,
                format: fFormat.value,
            };

            const isEditing = Boolean(editingBookId);
            saveBtn.textContent = "Salvataggio...";
            (saveBtn as HTMLButtonElement).disabled = true;

            try {
                const response = await fetch(
                    isEditing
                        ? `${API_BASE_URL}/api/books/${editingBookId}`
                        : `${API_BASE_URL}/api/books`,
                    {
                        method: isEditing ? "PATCH" : "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify(bookToSave),
                    },
                );

                if (response.ok) {
                    alert(
                        isEditing
                            ? "✅ Modifiche salvate!"
                            : "✅ Libro salvato nel DB!",
                    );
                    bookFormContainer?.classList.add("hidden");
                    searchQuery.value = "";
                    if (isEditing) {
                        editSearchQuery.value = "";
                        if (editResults) editResults.innerHTML = "";
                        editingBookId = null;
                    }
                } else if (response.status === 401) {
                    handleAuthExpired();
                } else {
                    const err = await response.json();
                    alert("❌ Errore: " + err.error);
                }
            } catch (err) {
                alert("Connessione fallita.");
            } finally {
                saveBtn.textContent = editingBookId
                    ? "Salva Modifiche"
                    : "Salva nel Database";
                (saveBtn as HTMLButtonElement).disabled = false;
            }
        });
    </script>
</Layout>
