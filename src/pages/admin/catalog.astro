---
import Layout from '../../components/Layout.astro';
---

<Layout title="Catalogazione Libri">
  <main class="p-8">
    <h1 class="text-2xl font-bold mb-4">Aggiungi Nuovo Libro</h1>
    
    <div class="flex gap-2 mb-8">
      <input type="text" id="searchQuery" class="border p-2" placeholder="Titolo o ISBN...">
      <button id="searchBtn" class="bg-red-600 text-white px-4">Search on Google Books</button>
    </div>

    <div id="preview" class="hidden border p-4 bg-gray-50 text-black">
      <img id="prevCover" src="" class="w-32 mb-2" alt="Copertina">
      <h2 id="prevTitle" class="font-bold"></h2>
      <p id="prevAuthor"></p>
      <button id="saveBtn" class="mt-4 bg-black text-white px-6 py-2">Confirm and Save</button>
    </div>
  </main>

  <script>

  interface BookData {
    title: string;
    author: string;
    description: string;
    coverUrl: string;
  }

  let currentBook: BookData | null = null;

  const searchBtn = document.getElementById('searchBtn');
  const searchQuery = document.getElementById('searchQuery') as HTMLInputElement;
  const prevTitle = document.getElementById('prevTitle');
  const prevCover = document.getElementById('prevCover') as HTMLImageElement;
  const previewDiv = document.getElementById('preview');
  const saveBtn = document.getElementById('saveBtn');

  searchBtn?.addEventListener('click', async () => {
    const q = searchQuery.value;
    if (!q) return;

    try {
        const res = await fetch(`https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(q)}`)
        const data = await res.json();

        if (!data.items) {
            alert("Nessun libro trovato su Google Books");
            return;
        }

        const info = data.items[0].volumeInfo;

        currentBook = {
            title: info.title,
            author: info.authors?.join(', ') || 'Unknown',
            description: info.description || '',
            coverUrl: info.imageLinks?.thumbnail ? info.imageLinks.thumbnail.replace('http:', 'https:') : ''
        };

        if (prevTitle) prevTitle.innerText = currentBook.title;
        if (prevCover) prevCover.src = currentBook.coverUrl;
        previewDiv?.classList.remove('hidden');
    } catch (err) {
        console.error("Errore durante la ricerca:", err);
    }
  });

  saveBtn?.addEventListener('click', async () => {
    if (!currentBook) return;

    // Gestione Token Manuale per ora
    let token = localStorage.getItem('admin_token');
    
    if (!token) {
      const password = prompt("Inserisci la password admin per salvare:");
      if (!password) return;

      try {
        const loginRes = await fetch('https://book-api.trnq.eu/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });
        const loginData = await loginRes.json();
        if (loginData.token) {
          token = loginData.token;
          localStorage.setItem('admin_token', token);
        } else {
          alert("Password errata");
          return;
        }
      } catch (e) {
        alert("Errore durante il login");
        return;
      }
    }

    // Salvataggio tramite Fetch diretta (Senza Astro Actions)
    try {
      const response = await fetch('https://book-api.trnq.eu/api/books', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(currentBook)
      });

      if (response.ok) {
        alert(`Successo! Salvato: ${currentBook.title}`);
        previewDiv?.classList.add('hidden');
        searchQuery.value = "";
      } else if (response.status === 401 || response.status === 403) {
        localStorage.removeItem('admin_token');
        alert("Sessione scaduta o non autorizzata. Riprova.");
      } else {
        alert("Errore durante il salvataggio sul server.");
      }
    } catch (err) {
      alert("Impossibile connettersi al server API.");
    }
  });
  </script>
</Layout>