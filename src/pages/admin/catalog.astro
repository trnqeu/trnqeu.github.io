---
import Layout from '../../components/Layout.astro';
---

<Layout title="Admin - Catalogazione Libri">
  <main class="p-8 max-w-4xl mx-auto min-h-screen">
    
    <div id="loginSection" class="border p-8 bg-white shadow-xl rounded-lg">
      <h1 class="text-2xl font-bold mb-6 text-center text-black">Accesso Catalogo</h1>
      <div class="flex flex-col gap-4">
        <input type="password" id="adminPassword" class="border p-3 rounded text-black" placeholder="Inserisci password admin...">
        <button id="loginBtn" class="bg-red-600 text-white py-3 rounded font-bold uppercase hover:bg-red-700 transition-all">Entra</button>
      </div>
    </div>

    <div id="adminContent" class="hidden">
      <div class="flex justify-between items-center mb-8 bg-gray-100 p-4 rounded border">
        <span class="font-bold text-black uppercase text-sm tracking-wider">Pannello Admin</span>
        <button id="logoutBtn" class="text-xs bg-black text-white px-3 py-1 rounded hover:bg-gray-800 uppercase font-bold">Esci</button>
      </div>

      <h1 class="text-2xl font-bold mb-4 text-black text-center">Aggiungi Nuovo Libro</h1>
      
      <div class="flex gap-2 mb-8">
        <input type="text" id="searchQuery" class="border p-3 flex-grow text-black rounded shadow-sm focus:ring-2 focus:ring-red-500 outline-none" placeholder="Titolo o ISBN...">
        <button id="searchBtn" class="bg-red-600 text-white px-6 rounded hover:bg-red-700 font-bold uppercase transition-all">Cerca</button>
      </div>

      <div id="bookFormContainer" class="hidden border p-6 bg-white text-black shadow-lg rounded-lg animate-in fade-in duration-300">
        <h2 class="text-lg font-bold mb-4 border-b pb-2 uppercase text-gray-700">Modifica Dettagli</h2>
        
        <div class="grid grid-cols-1 gap-5">
          <div class="flex justify-center bg-gray-50 py-4 rounded">
            <img id="formCoverPreview" class="w-32 border shadow-md hidden" alt="Cover">
          </div>

          <label class="block">
            <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Titolo<br></span>
            <input type="text" id="formTitle" class="w-full border p-2 mt-1 rounded font-medium">
          </label>

          <label class="block">
            <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Autore<br></span>
            <input type="text" id="formAuthor" class="w-full border p-2 mt-1 rounded">
          </label>

          <label class="block">
            <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Casa Editrice<br></span>
            <input type="text" id="formPublisher" class="w-full border p-2 mt-1 rounded">
          </label>

          <div class="grid grid-cols-2 gap-4">
            <label class="block">
              <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Lingua<br></span>
              <input type="text" id="formLanguage" class="w-full border p-2 mt-1 rounded">
            </label>
            <label class="block">
              <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Formato<br></span>
              <select id="formFormat" class="w-full border p-2 mt-1 rounded bg-white">
                <option value="Cartaceo">Cartaceo</option>
                <option value="Ebook">Ebook</option>
              </select>
            </label>
          </div>

          <label class="block">
            <span class="text-xs text-gray-500 uppercase font-bold italic"><br>Descrizione<br></span>
            <textarea id="formDescription" rows="10" class="w-full border p-2 mt-1 rounded text-sm"></textarea>
          </label>

          <label class="block">
            <span class="text-xs text-gray-400 uppercase font-bold italic tracking-tighter"><br>URL Immagine<br></span>
            <input type="text" id="formCoverUrl" class="w-full border p-2 mt-1 text-[10px] text-blue-500 rounded font-mono">
          </label>

          <button id="saveBtn" class="mt-6 bg-red-600 text-white px-6 py-4 font-bold hover:bg-red-700 transition-all uppercase rounded-md shadow-lg active:scale-95">
            Conferma e Salva nel Database
          </button>
        </div>
      </div>
    </div>
  </main>

  <script>
    // --- ELEMENTI UI ---
    const loginSection = document.getElementById('loginSection');
    const adminContent = document.getElementById('adminContent');
    const adminPassword = document.getElementById('adminPassword') as HTMLInputElement;
    const loginBtn = document.getElementById('loginBtn');
    const logoutBtn = document.getElementById('logoutBtn');

    const searchBtn = document.getElementById('searchBtn');
    const searchQuery = document.getElementById('searchQuery') as HTMLInputElement;
    const bookFormContainer = document.getElementById('bookFormContainer');
    
    const fTitle = document.getElementById('formTitle') as HTMLInputElement;
    const fAuthor = document.getElementById('formAuthor') as HTMLInputElement;
    const fPublisher = document.getElementById('formPublisher') as HTMLInputElement;
    const fLanguage = document.getElementById('formLanguage') as HTMLInputElement;
    const fFormat = document.getElementById('formFormat') as HTMLSelectElement;
    const fDescription = document.getElementById('formDescription') as HTMLTextAreaElement;
    const fCoverUrl = document.getElementById('formCoverUrl') as HTMLInputElement;
    const fCoverPreview = document.getElementById('formCoverPreview') as HTMLImageElement;
    const saveBtn = document.getElementById('saveBtn');

    // --- GESTIONE ACCESSO ---
    const updateUI = () => {
      const token = localStorage.getItem('admin_token');
      if (token) {
        loginSection?.classList.add('hidden');
        adminContent?.classList.remove('hidden');
      } else {
        loginSection?.classList.remove('hidden');
        adminContent?.classList.add('hidden');
      }
    };

    updateUI(); // Esegui al caricamento della pagina

    loginBtn?.addEventListener('click', async () => {
      const password = adminPassword.value;
      try {
        const res = await fetch('https://book-api.trnq.eu/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });
        const data = await res.json();
        if (data.token) {
          localStorage.setItem('admin_token', data.token);
          updateUI();
        } else { alert("Password Errata"); }
      } catch (e) { alert("Server non raggiungibile"); }
    });

    logoutBtn?.addEventListener('click', () => {
      localStorage.removeItem('admin_token');
      updateUI();
    });

    // --- LOGICA RICERCA ---
    searchBtn?.addEventListener('click', async () => {
      const q = searchQuery.value;
      if (!q) return;

      try {
        const res = await fetch(`https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        if (!data.items) { alert("Nessun libro trovato"); return; }

        const info = data.items[0].volumeInfo;
        fTitle.value = info.title || '';
        fAuthor.value = info.authors?.join(', ') || '';
        fPublisher.value = info.publisher || '';
        fLanguage.value = info.language || 'it';
        fDescription.value = info.description || '';
        
        const thumb = info.imageLinks?.thumbnail ? info.imageLinks.thumbnail.replace('http:', 'https:') : '';
        fCoverUrl.value = thumb;
        if (thumb) {
          fCoverPreview.src = thumb;
          fCoverPreview.classList.remove('hidden');
        } else {
          fCoverPreview.classList.add('hidden');
          fCoverPreview.removeAttribute('src');
        }

        bookFormContainer?.classList.remove('hidden');
      } catch (err) { console.error("Errore ricerca:", err); }
    });

    // --- LOGICA SALVATAGGIO ---
    saveBtn?.addEventListener('click', async () => {
      const token = localStorage.getItem('admin_token');
      if (!token) return;

      const bookToSave = {
        title: fTitle.value,
        author: fAuthor.value,
        description: fDescription.value,
        coverUrl: fCoverUrl.value,
        publishingHouse: fPublisher.value,
        language: fLanguage.value,
        format: fFormat.value
      };

      try {
        const response = await fetch('https://book-api.trnq.eu/api/books', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(bookToSave)
        });

        if (response.ok) {
          alert("✅ Libro salvato nel DB!");
          bookFormContainer?.classList.add('hidden');
          searchQuery.value = "";
        } else {
          const err = await response.json();
          alert("❌ Errore: " + err.error);
        }
      } catch (err) { alert("Connessione fallita."); }
    });
  </script>
</Layout>