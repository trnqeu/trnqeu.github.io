---
import Layout from "../../components/Layout.astro";

const projects = [
  {
    title: "Multivrss",
    description: "Your internet reading room: RSS feeds and bookmarks.",
    slug: "multivrss",
  },
  {
    title: "Eblioteque",
    description: "My e-biblioteque.",
    slug: "eblioteque",
  },
  {
    title: "Ideas",
    description: "Posts, random thoughts.",
    slug: "ideas",
  },
  {
    title: "Prompts on Canvas",
    description: "Masterpieces of generative art",
    slug: "promptsoncanvas",
  },
  {
    title: "Murder, he prompted",
    description: "Chief Prompter Jameson Aguardento reporting for duty.",
    slug: "murder-he-prompted",
  },
  {
    title: "Sottolinee",
    description: "Una collezione di sottolineature.",
    slug: "sottolinee",
  },
  {
    title: "Racconti / Short Stories",
    description: "A collection of short stories I've written in the past.",
    slug: "short-stories",
  },
];
---

<Layout
  title="Projects"
  description="Browse through the projects."
  showSidebar={false}
  lang="en"
>
  <div class="projects-page">
    <header class="page-header">
      <p class="kicker">Index</p>
      <h1 class="page-title">Projects</h1>
      <p class="page-description">Browse through the projects.</p>
    </header>

    <div class="index-list">
      {
        projects.map((project, idx) => (
          <a href={`/en/projects/${project.slug}`} class="index-row">
            <span class="n">{String(idx + 1).padStart(2, "0")}</span>
            <span class="t">{project.title}</span>
            <span class="d">{project.description}</span>
          </a>
        ))
      }
    </div>

    {
      projects.length === 0 && (
        <div class="no-projects">
          <p>No projects found.</p>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .projects-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 44px 0 60px;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .page-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0;
  }

  .index-list {
    border-top: 2px solid var(--color-border-strong);
  }

  .index-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 2px;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: 0.2s;
  }

  .index-row:hover {
    padding-left: 16px;
    background: var(--color-surface);
  }

  .index-row .n {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    width: 28px;
    flex: none;
  }

  .index-row .t {
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--color-text-primary);
    flex: none;
  }

  .index-row:hover .t {
    color: var(--color-accent);
  }

  .index-row .d {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    flex: 1;
    text-align: right;
  }

  .no-projects {
    text-align: center;
    padding: calc(var(--grid-unit) * 6);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .index-row {
      flex-wrap: wrap;
    }

    .index-row .d {
      display: none;
    }
  }
</style>
