---
import Layout from '../../../components/Layout.astro';
import quotes from '../../../../public/all_quotes.json';

const base = import.meta.env.BASE_URL;

const allBooks = Object.values(quotes);
const randomBookIndex = Math.floor(Math.random() * allBooks.length);
const randomBook = allBooks[randomBookIndex];
const randomQuoteIndex = Math.floor(Math.random() * randomBook.quotes.length);
const randomQuote = randomBook.quotes[randomQuoteIndex];
const totalQuotes = allBooks.reduce((sum, book) => sum + book.quotes.length, 0);
---

<Layout title="Underlines" description="A collection of underlines from books I've read." lang="en">
  <div class="project-page">
    <header class="page-header">
      <p class="kicker">Underlines · {totalQuotes}</p>
      <h1 class="page-title">Kept lines</h1>
      <p class="page-description"># lines I underlined while reading</p>
    </header>

    <div class="underline-item random-quote-block">
      <p class="random-quote">{randomQuote}</p>
      <div class="source">
        <span class="author">{randomBook.author}</span><span>·</span><span class="work">{randomBook.title}</span>
      </div>
      <button id="refresh-quote">Another one</button>
    </div>

    <div class="quotes-list">
      {Object.values(quotes).map(book => (
        <details class="book-entry">
          <summary class="book-title">
            {book.title} <span class="book-author">— {book.author}</span>
          </summary>
          <div class="quotes-content">
            {book.quotes.map(quote => (
              <div class="underline-item">
                <p class="quote-text">{quote}</p>
                <div class="source">
                  <span class="author">{book.author}</span><span>·</span><span class="work">{book.title}</span>
                </div>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div class="page-navigation">
      <a href="/en/projects" class="back-link">← Projects</a>
    </div>
  </div>
</Layout>

<script define:vars={{ quotes }}>
  const allBooks = Object.values(quotes);

  document.getElementById('refresh-quote').addEventListener('click', () => {
    const randomBookIndex = Math.floor(Math.random() * allBooks.length);
    const randomBook = allBooks[randomBookIndex];
    const randomQuoteIndex = Math.floor(Math.random() * randomBook.quotes.length);
    const randomQuote = randomBook.quotes[randomQuoteIndex];

    document.querySelector('.random-quote-block .random-quote').innerHTML = randomQuote;
    document.querySelector('.random-quote-block .author').innerHTML = randomBook.author;
    document.querySelector('.random-quote-block .work').innerHTML = randomBook.title;
  });
</script>

<style>
  .project-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 44px 0 60px;
  }

  .page-header {
    margin-bottom: 36px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 12px;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .page-description {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .underline-item {
    border-top: 1px solid var(--color-border);
    padding: 30px 0 30px 22px;
    border-left: var(--accent-rule);
    margin-left: 2px;
  }

  .underline-item .random-quote,
  .underline-item .quote-text {
    font-size: 1.6rem;
    line-height: 1.4;
    font-weight: 500;
    color: var(--color-text-primary);
    max-width: 56ch;
    margin: 0 0 14px;
  }

  .source {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    display: flex;
    gap: 10px;
  }

  .source .author {
    color: var(--color-accent);
  }

  .random-quote-block {
    margin-bottom: 44px;
  }

  #refresh-quote {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    background-color: transparent;
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  #refresh-quote:hover,
  #refresh-quote:focus {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .quotes-list {
    display: flex;
    flex-direction: column;
    margin-bottom: calc(var(--grid-unit) * 6);
    border-top: 2px solid var(--color-border-strong);
  }

  .book-entry {
    border-bottom: 1px solid var(--color-border);
  }

  .book-title {
    font-weight: 600;
    font-size: 1.05rem;
    padding: 16px 2px;
    cursor: pointer;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .book-author {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .book-title:hover {
    color: var(--color-accent);
  }

  .quotes-content {
    padding: 0 0 12px;
  }

  .quotes-content .underline-item {
    border-top: 1px solid var(--color-border);
  }

  .quotes-content .underline-item:first-child {
    border-top: none;
  }

  .page-navigation {
    padding-top: calc(var(--grid-unit) * 4);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.72rem;
    color: var(--color-accent);
  }
</style>
