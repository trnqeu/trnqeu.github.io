---
import Layout from '../../components/Layout.astro';
import { localize, slugFromFile } from '../../utils/i18n';

const lang: 'en' | 'it' = 'en';
const base = import.meta.env.BASE_URL;
const prefix = 'en/';

// ——— scritti: stessi glob della home precedente, con il sistema di
// traduzione reale (fallback alla lingua originale se manca l'EN) ———
const mdPostsGlob = import.meta.glob('../../content/ideas/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../../content/ideas/*.mdx', { eager: true });
const murderHePromptedPostsGlob = import.meta.glob('../../content/murderheprompted/*.md', { eager: true });
const murderHePromptedMdxPostsGlob = import.meta.glob('../../content/murderheprompted/*.mdx', { eager: true });
const shortStoriesPostsGlob = import.meta.glob('../../content/shortstories/*.md', { eager: true });
const shortStoriesMdxPostsGlob = import.meta.glob('../../content/shortstories/*.mdx', { eager: true });
const promptsOnCanvasPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.md', { eager: true });
const promptsOnCanvasMdxPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.mdx', { eager: true });
const allPosts = [
  ...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob),
  ...Object.values(murderHePromptedPostsGlob), ...Object.values(murderHePromptedMdxPostsGlob),
  ...Object.values(shortStoriesPostsGlob), ...Object.values(shortStoriesMdxPostsGlob),
  ...Object.values(promptsOnCanvasPostsGlob), ...Object.values(promptsOnCanvasMdxPostsGlob),
] as any[];

const localizedPosts = localize(allPosts, lang)
  .map(({ post, isFallback }) => ({ ...post, isFallback }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = localizedPosts.slice(0, 6);       // 6 rows: as many as fit without scrolling

const i18n = {
  it: {
    projects: 'progetti', writings: 'scritti',
    allProjects: 'tutti i progetti →', allWritings: "tutto l'archivio →",
    tagline: '[pensieri, parole, opere o missioni]', info: 'info',
    months: ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'],
  },
  en: {
    projects: 'projects', writings: 'writing',
    allProjects: 'all projects →', allWritings: 'the whole archive →',
    tagline: '[thoughts, words, snippets]', info: 'info',
    months: ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'],
  },
};
const dict = i18n[lang];

const projects = [
  { slug: 'multivrss',           title: 'Multivrss',              meta: { it: 'aggregatore di feed RSS', en: 'RSS feed aggregator' } },
  { slug: 'eblioteque',          title: 'Eblioteque',              meta: { it: 'la mia biblioteca digitale', en: 'my e-biblioteque' } },
  { slug: 'ideas',               title: 'Ideas',                  meta: { it: 'appunti e pensieri sparsi', en: 'posts, random thoughts' } },
  { slug: 'promptsoncanvas',     title: 'Prompts on canvas',      meta: { it: 'arte generativa', en: 'generative art' } },
  { slug: 'murder-he-prompted',  title: 'Murder, he prompted',    meta: { it: 'serie · in corso', en: 'series · ongoing' } },
  { slug: 'sottolinee',          title: 'Sottolinee',             meta: { it: 'righe tenute', en: 'kept lines' } },
  { slug: 'short-stories',       title: 'Racconti / Short stories', meta: { it: 'racconti brevi', en: 'short stories' } },
];

// frontmatter `date` is a bare "YYYY-MM-DD" string when quoted in the
// source, but an unquoted `date: 2025-10-29` gets YAML-parsed to a Date and
// then serialized as a full ISO string ("…T00:00:00.000Z") — appending
// 'T00:00:00' to that (as if it were still a bare date) breaks parsing and
// yields "Invalid Date". Only append it when there's no time part yet.
function fmtDate(input: string | Date): string {
  const iso = input instanceof Date ? input.toISOString() : input;
  const d = new Date(iso.includes('T') ? iso : `${iso}T00:00:00`);
  const m = dict.months[d.getMonth()];
  return lang === 'it' ? `${d.getDate()} ${m} ${d.getFullYear()}` : `${m} ${d.getDate()}, ${d.getFullYear()}`;
}

function postHref(post: any): string {
  const dir = post.file.includes('/murderheprompted/') ? 'murderheprompted/'
    : post.file.includes('/shortstories/') ? 'shortstories/'
    : post.file.includes('/promptsoncanvas/') ? 'promptsoncanvas/'
    : 'ideas/';
  return `${base}${prefix}${dir}${slugFromFile(post.file)}`;
}
---

<Layout
  title="Trnq.eu: Stefano Trinchero's Personal Website"
  description="Ideas, short stories, digital projects, and some code snippets."
  showSidebar={false}
  fullHeight={true}
  lang={lang}
>
  <div class="tq-bivio">

    <!-- LEFT HALF — PROJECTS -->
    <section class="tq-pane" aria-labelledby="tq-h-projects">
      <header class="tq-pane-head">
        <h2 id="tq-h-projects">{dict.projects}</h2>
      </header>
      <nav class="tq-pane-list">
        {projects.map((p, i) => (
          <a class="tq-pane-row" href={`${base}${prefix}projects/${p.slug}`}>
            <span class="c">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{p.title}</span>
            <span class="m">{p.meta[lang]}</span>
          </a>
        ))}
      </nav>
      <a class="tq-pane-more" href={`${base}${prefix}projects`}>{dict.allProjects}</a>
    </section>

    <!-- RIGHT HALF — WRITING -->
    <section class="tq-pane" aria-labelledby="tq-h-writings">
      <header class="tq-pane-head">
        <h2 id="tq-h-writings">{dict.writings}</h2>
      </header>
      <nav class="tq-pane-list">
        {latest.map(post => {
          const fm = post.frontmatter;
          const cat = (fm.categories || [])[0];
          return (
            <a class="tq-pane-row" href={postHref(post)}>
              <span class="c wide">{fmtDate(fm.date)}</span>
              <span class="t">{fm.title}</span>
              <span class="m">{fm.lang}{cat ? ' · ' + cat.toLowerCase() : ''}</span>
            </a>
          );
        })}
      </nav>
      <a class="tq-pane-more" href={`${base}${prefix}writing`}>{dict.allWritings}</a>
    </section>

  </div>

  <div class="tq-bivio-foot">
    <span>{dict.tagline}</span>
    <span>2019—2026 · <a href={`${base}${prefix}about`}>{dict.info}</a></span>
  </div>
</Layout>

<style>
  /* ————— the fork ————— */
  .tq-bivio{
    display:flex;
    flex:1;
    min-height:0;
    margin: 0 calc(var(--content-padding) * -1);   /* breaks out of the container: the halves run edge to edge */
  }

  .tq-pane{
    flex:1; min-width:0;
    display:flex; flex-direction:column; gap:calc(var(--grid-unit)*3);
    padding: calc(var(--grid-unit)*6) calc(var(--grid-unit)*5.5);
    transition: flex .5s cubic-bezier(.2,.8,.2,1), background .35s ease;
  }
  .tq-pane + .tq-pane{ border-left:1px solid var(--color-border); }

  /* opening: only on pointers with real hover */
  @media (hover:hover) and (min-width:901px){
    .tq-bivio:hover .tq-pane{ flex:.75; }
    .tq-bivio:hover .tq-pane:hover,
    .tq-pane:focus-within{ flex:1.45; background:var(--color-surface); }
  }

  .tq-pane-head h2{
    margin:0; font-size:clamp(2.6rem, 4.4vw, 4rem); font-weight:600;
    letter-spacing:-.03em; line-height:1; color:var(--color-text-primary);
    text-transform:none;
  }

  /* the index is present but "off" until you look at that half */
  .tq-pane-list{
    display:flex; flex-direction:column;
    border-top:2px solid var(--color-border-strong);
    opacity:.28; transition:opacity .35s ease;
  }
  @media (hover:hover) and (min-width:901px){
    .tq-pane:hover .tq-pane-list,
    .tq-pane:focus-within .tq-pane-list{ opacity:1; }
  }

  .tq-pane-row{
    display:flex; align-items:baseline; gap:18px;
    padding:9px 0; border-bottom:1px solid var(--color-border);
    text-decoration:none; color:var(--color-text-primary);
    transition:color .18s ease, padding-left .18s ease;
  }
  .tq-pane-row:hover{ color:var(--color-accent); padding-left:8px; }
  .tq-pane-row .c{
    font-family:var(--font-mono); font-size:.7rem; color:var(--color-text-muted);
    width:24px; flex:none;
  }
  .tq-pane-row .c.wide{ width:104px; }
  .tq-pane-row .t{ min-width:0; font-size:1.18rem; font-weight:600; letter-spacing:-.01em;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tq-pane-row .m{
    margin-left:auto; padding-left:12px; flex:none;
    font-family:var(--font-mono); font-size:.7rem; color:var(--color-text-muted);
    text-transform:lowercase;
  }

  .tq-pane-more{
    margin-top:auto;
    font-family:var(--font-mono); font-size:.7rem; letter-spacing:.1em;
    text-transform:uppercase; color:var(--color-text-muted); text-decoration:none;
    opacity:0; transition:opacity .3s ease, color .18s ease;
  }
  .tq-pane-more:hover{ color:var(--color-accent); }
  @media (hover:hover) and (min-width:901px){
    .tq-pane:hover .tq-pane-more,
    .tq-pane:focus-within .tq-pane-more{ opacity:1; }
  }

  /* ————— foot ————— */
  .tq-bivio-foot{
    display:flex; justify-content:space-between; gap:var(--grid-unit);
    margin: 0 calc(var(--content-padding) * -1);
    padding: calc(var(--grid-unit)*2) calc(var(--grid-unit)*5.5);
    border-top:1px solid var(--color-border);
    font-family:var(--font-mono); font-size:.7rem; letter-spacing:.1em;
    text-transform:uppercase; color:var(--color-text-muted);
  }
  .tq-bivio-foot a{ color:var(--color-text-muted); text-decoration:none; }
  .tq-bivio-foot a:hover{ color:var(--color-accent); }

  /* ————— responsive ————— */
  @media (max-width:900px){
    .tq-bivio{ flex-direction:column; flex:none; }
    .tq-pane{ padding: calc(var(--grid-unit)*5) calc(var(--grid-unit)*3); gap:calc(var(--grid-unit)*3); }
    .tq-pane + .tq-pane{ border-left:none; border-top:1px solid var(--color-border); }
    .tq-pane-list{ opacity:1; }          /* on touch the indexes are always on */
    .tq-pane-more{ opacity:1; }
    .tq-pane-head h2{ font-size:2.4rem; }
  }
  @media (max-width:480px){
    .tq-pane-row{ flex-wrap:wrap; gap:8px 12px; }
    .tq-pane-row .t{ white-space:normal; font-size:1.05rem; }
    .tq-pane-row .m{ margin-left:0; padding-left:0; width:100%; }
    .tq-pane-row .c.wide{ width:auto; }
  }

  /* ————— accessibility ————— */
  @media (prefers-reduced-motion:reduce){
    .tq-pane, .tq-pane-list, .tq-pane-more, .tq-pane-row{ transition:none; }
  }
</style>
