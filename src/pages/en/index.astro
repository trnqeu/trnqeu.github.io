---
import Layout from '../../components/Layout.astro';
import { localize, postUrl, isExternal, mirroredAlternates, collectionFromFile } from '../../utils/i18n';

const lang: 'en' | 'it' = 'en';
const base = import.meta.env.BASE_URL;
const prefix = 'en/';

// ——— scritti: stessi glob della home precedente, con il sistema di
// traduzione reale (fallback alla lingua originale se manca l'EN) ———
const mdPostsGlob = import.meta.glob('../../content/ideas/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../../content/ideas/*.mdx', { eager: true });
const murderHePromptedPostsGlob = import.meta.glob('../../content/murderheprompted/*.md', { eager: true });
const murderHePromptedMdxPostsGlob = import.meta.glob('../../content/murderheprompted/*.mdx', { eager: true });
const shortStoriesPostsGlob = import.meta.glob('../../content/shortstories/*.md', { eager: true });
const shortStoriesMdxPostsGlob = import.meta.glob('../../content/shortstories/*.mdx', { eager: true });
const promptsOnCanvasPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.md', { eager: true });
const promptsOnCanvasMdxPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.mdx', { eager: true });
const commissarioGipitiPostsGlob = import.meta.glob('../../content/commissario-gipiti/*.{md,mdx}', { eager: true });
const elsewherePostsGlob = import.meta.glob('../../content/elsewhere/*.md', { eager: true });
const allPosts = [
  ...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob),
  ...Object.values(murderHePromptedPostsGlob), ...Object.values(murderHePromptedMdxPostsGlob),
  ...Object.values(shortStoriesPostsGlob), ...Object.values(shortStoriesMdxPostsGlob),
  ...Object.values(promptsOnCanvasPostsGlob), ...Object.values(promptsOnCanvasMdxPostsGlob),
  ...Object.values(commissarioGipitiPostsGlob),
  ...Object.values(elsewherePostsGlob),
] as any[];

const localizedPosts = localize(allPosts, lang)
  .map(({ post, isFallback }) => ({ ...post, isFallback }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = localizedPosts.slice(0, 10);      // 10 rows: matches the number of projects

const i18n = {
  it: {
    projects: 'progetti', writings: 'scritti',
    allProjects: 'tutti i progetti', allWritings: 'tutti gli scritti',
    tagline: '[pensieri, parole, opere o missioni]', info: 'info',
    kinds: { ideas: 'idee', shortstories: 'racconto', promptsoncanvas: 'immagini', murderheprompted: 'serie', 'commissario-gipiti': 'serie' } as Record<string, string>,
    months: ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'],
  },
  en: {
    projects: 'projects', writings: 'writing',
    allProjects: 'all projects', allWritings: 'all writing',
    tagline: '[thoughts, words, snippets]', info: 'info',
    kinds: { ideas: 'ideas', shortstories: 'short story', promptsoncanvas: 'images', murderheprompted: 'series', 'commissario-gipiti': 'series' } as Record<string, string>,
    months: ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'],
  },
};
const dict = i18n[lang];

const projects = [
  { slug: 'commissario-gipiti',  title: 'I casi del Commissario Gipiti', meta: { it: 'serie · in corso', en: 'series · ongoing' } },
  { slug: 'undurable',           title: 'Undurable',              meta: { it: 'laboratorio sull’impermanenza', en: 'a lab on impermanence' } },
  { slug: 'multivrss',           title: 'Multivrss',              meta: { it: 'aggregatore di feed RSS', en: 'RSS feed aggregator' } },
  { slug: 'clockwork-leagues',   title: 'Clockwork Leagues',      meta: { it: 'campionati che giocano da soli', en: 'leagues that play themselves' } },
  { slug: 'eblioteque',          title: 'Eblioteque',              meta: { it: 'la mia biblioteca digitale', en: 'my e-biblioteque' } },
  { slug: 'ideas',               title: 'Ideas',                  meta: { it: 'appunti e pensieri sparsi', en: 'posts, random thoughts' } },
  { slug: 'promptsoncanvas',     title: 'Prompts on canvas',      meta: { it: 'arte generativa', en: 'generative art' } },
  { slug: 'murder-he-prompted',  title: 'Murder, he prompted',    meta: { it: 'serie · in corso', en: 'series · ongoing' } },
  { slug: 'sottolinee',          title: 'Sottolinee',             meta: { it: 'righe tenute', en: 'kept lines' } },
  { slug: 'short-stories',       title: 'Racconti / Short stories', meta: { it: 'racconti brevi', en: 'short stories' } },
];

// frontmatter `date` is a bare "YYYY-MM-DD" string when quoted in the
// source, but an unquoted `date: 2025-10-29` gets YAML-parsed to a Date and
// then serialized as a full ISO string ("…T00:00:00.000Z") — appending
// 'T00:00:00' to that (as if it were still a bare date) breaks parsing and
// yields "Invalid Date". Only append it when there's no time part yet.
function fmtDate(input: string | Date): string {
  const iso = input instanceof Date ? input.toISOString() : input;
  const d = new Date(iso.includes('T') ? iso : `${iso}T00:00:00`);
  const m = dict.months[d.getMonth()];
  return lang === 'it' ? `${d.getDate()} ${m} ${d.getFullYear()}` : `${m} ${d.getDate()}, ${d.getFullYear()}`;
}

---

<Layout
  title="Trnq.eu: Stefano Trinchero's Personal Website"
  description="Ideas, short stories, digital projects, and some code snippets."
  showSidebar={false}
  fullHeight={true}
  lang={lang}
  alternateUrls={mirroredAlternates(Astro.url.pathname)}
>
  <h1 class="sr-only">Stefano Trinchero: ideas, short stories and digital projects</h1>
  <div class="tq-bivio">

    <!-- PROJECTS -->
    <section class="tq-pane" aria-labelledby="tq-h-projects">
      <header class="tq-pane-head">
        <h2 id="tq-h-projects">{dict.projects}</h2>
        <a class="tq-pane-more" href={`${base}${prefix}projects/`}>{dict.allProjects} <span aria-hidden="true">→</span></a>
      </header>
      <nav class="tq-pane-list">
        {projects.map(p => (
          <a class="tq-pane-row" href={`${base}${prefix}projects/${p.slug}/`}>
            <span class="t">{p.title}</span>
            <span class="m">{p.meta[lang]}</span>
          </a>
        ))}
      </nav>
    </section>

    <!-- WRITING -->
    <section class="tq-pane" aria-labelledby="tq-h-writings">
      <header class="tq-pane-head">
        <h2 id="tq-h-writings">{dict.writings}</h2>
        <a class="tq-pane-more" href={`${base}${prefix}writing/`}>{dict.allWritings} <span aria-hidden="true">→</span></a>
      </header>
      <nav class="tq-pane-list">
        {latest.map(post => {
          const fm = post.frontmatter;
          const kind = isExternal(post) ? `↗ ${fm.source}` : dict.kinds[collectionFromFile(post.file)];
          return (
            <a class="tq-pane-row" href={postUrl(post, lang)}>
              <span class="t">{fm.title}</span>
              <span class="d">{fmtDate(fm.date)}{post.isFallback && ` · ${fm.lang}`}{kind && ` · ${kind}`}</span>
            </a>
          );
        })}
      </nav>
    </section>

  </div>

  <!-- random order of the two halves: swapped in the DOM before first paint,
       so tab order follows the visual order too -->
  <script is:inline>
    (() => {
      if (Math.random() < 0.5) return;
      const bivio = document.querySelector('.tq-bivio');
      if (bivio && bivio.lastElementChild) bivio.prepend(bivio.lastElementChild);
    })();
  </script>

  <div class="tq-bivio-foot">
    <span>{dict.tagline}</span>
    <span>2019—2026 · <a href={`${base}${prefix}about/`}>{dict.info}</a></span>
  </div>
</Layout>

<style>
  /* ————— two side-by-side indexes, always readable ————— */
  .tq-bivio{
    flex:1;
    display:grid; grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:calc(var(--grid-unit)*7) calc(var(--grid-unit)*9);
    align-items:start;
    width:100%; max-width:1120px; margin:0 auto;
    padding: calc(var(--grid-unit)*6) 0;
  }

  .tq-pane{ min-width:0; display:flex; flex-direction:column; gap:calc(var(--grid-unit)*2); }

  .tq-pane-head{
    display:flex; justify-content:space-between; align-items:baseline; gap:var(--grid-unit);
    padding-bottom:10px; border-bottom:2px solid var(--color-border-strong);
  }
  .tq-pane-head h2{
    margin:0; font-size:1.75rem; font-weight:600; letter-spacing:-.02em; line-height:1.1;
    color:var(--color-text-primary); text-transform:capitalize;
  }

  .tq-pane-list{ display:flex; flex-direction:column; }

  .tq-pane-row{
    display:flex; flex-direction:column; gap:3px;
    padding:12px 0; border-bottom:1px solid var(--color-border);
    text-decoration:none; color:var(--color-text-primary);
  }
  .tq-pane-row .t{
    font-size:1.125rem; font-weight:600; letter-spacing:-.01em; line-height:1.3;
    overflow-wrap:break-word; text-wrap:pretty; transition:color .18s ease;
  }
  .tq-pane-row:hover .t{ color:var(--color-accent); }
  .tq-pane-row .m{ font-size:.875rem; line-height:1.4; color:var(--color-text-secondary); }
  .tq-pane-row .d{ font-family:var(--font-mono); font-size:.75rem; color:var(--color-text-muted); }

  .tq-pane-more{
    flex:none; font-family:var(--font-mono); font-size:.75rem;
    color:var(--color-text-muted); text-decoration:none; transition:color .18s ease;
  }
  .tq-pane-more:hover{ color:var(--color-accent); }

  /* ————— footer ————— */
  .tq-bivio-foot{
    display:flex; justify-content:space-between; gap:var(--grid-unit);
    width:100%; max-width:1120px; margin:0 auto;
    padding: calc(var(--grid-unit)*2) 0;
    border-top:1px solid var(--color-border);
    font-family:var(--font-mono); font-size:.7rem; letter-spacing:.1em;
    text-transform:uppercase; color:var(--color-text-muted);
  }
  .tq-bivio-foot a{ color:var(--color-text-muted); text-decoration:none; }
  .tq-bivio-foot a:hover{ color:var(--color-accent); }

  /* ————— responsive ————— */
  @media (max-width:900px){
    .tq-bivio{ grid-template-columns:minmax(0, 1fr); padding-top:calc(var(--grid-unit)*4); }
  }

  @media (prefers-reduced-motion:reduce){
    .tq-pane-row .t, .tq-pane-more{ transition:none; }
  }
</style>
