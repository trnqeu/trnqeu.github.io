---
import Layout from '../../components/Layout.astro';
import Featured from '../../components/Featured.astro';

const lang: 'en' = 'en';

const mdPostsGlob = import.meta.glob('../../content/ideas/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../../content/ideas/*.mdx', { eager: true });
const murderHePromptedPostsGlob = import.meta.glob('../../content/murderheprompted/*.md', { eager: true });
const murderHePromptedMdxPostsGlob = import.meta.glob('../../content/murderheprompted/*.mdx', { eager: true });
const shortStoriesPostsGlob = import.meta.glob('../../content/shortstories/*.md', { eager: true });
const shortStoriesMdxPostsGlob = import.meta.glob('../../content/shortstories/*.mdx', { eager: true });
const promptsOnCanvasPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.md', { eager: true });
const promptsOnCanvasMdxPostsGlob = import.meta.glob('../../content/promptsoncanvas/*.mdx', { eager: true });
const allPosts = [...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob), ...Object.values(murderHePromptedPostsGlob), ...Object.values(murderHePromptedMdxPostsGlob), ...Object.values(shortStoriesPostsGlob), ...Object.values(shortStoriesMdxPostsGlob), ...Object.values(promptsOnCanvasPostsGlob), ...Object.values(promptsOnCanvasMdxPostsGlob)] as any[];
const sortedPosts = allPosts
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 10);

const base = import.meta.env.BASE_URL;

const i18n = {
  en: {
    tagline: '[thoughts, words, deeds or missions]',
    projectsTitle: 'Projects',
    projectsSub: 'Browse through the projects.',
    latestTitle: 'Latest writing',
    latestSub: 'The most recent publications.',
    searchPlaceholder: 'Search the writing…',
    filterAll: 'All',
    inThisLang: 'In English',
    months: ['January','February','March','April','May','June','July','August','September','October','November','December'],
  },
};

const dict = i18n.en;
const months = dict.months;

const projects = [
  { id: 'eblioteque', slug: 'eblioteque', title: 'Biblioteque',
    desc: { it: 'La mia biblioteca digitale.', en: 'My e-biblioteque.' } },
  { id: 'ideas', slug: 'ideas', title: 'Ideas',
    desc: { it: 'Appunti e pensieri sparsi.', en: 'Posts, random thoughts.' } },
  { id: 'prompts', slug: 'promptsoncanvas', title: 'Prompts on canvas',
    desc: { it: 'Piccoli capolavori di arte generativa.', en: 'Masterpieces of generative art.' } },
  { id: 'murder', slug: 'murder-he-prompted', title: 'Murder, he prompted',
    desc: { it: 'Il Capo Prompter Jameson Aguardento, in servizio.', en: 'Chief Prompter Jameson Aguardento reporting for duty.' } },
  { id: 'sottolinee', slug: 'sottolinee', title: 'Sottolinee',
    desc: { it: 'Una collezione di sottolineature.', en: 'A collection of underlines.' } },
  { id: 'racconti', slug: 'short-stories', title: 'Racconti / Short stories',
    desc: { it: 'Racconti brevi scritti nel tempo.', en: 'A collection of short stories I have written in the past.' } },
];

const allCategories = ['Fiction', 'Comedy', 'AI', 'Art'];

function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00');
  const m = months[d.getMonth()];
  return `${m} ${d.getDate()}, ${d.getFullYear()}`;
}
---

<Layout title="Trnq.eu: Stefano Trinchero's Personal Website" description="Ideas, short stories, digital projects, and some code snippets." showSidebar={false} lang="en">
  <div class="tq-home">

    <section class="tq-hero-monumental">
      <div class="tq-hero-inner">
        <h1>trnq</h1>
        <p class="tq-tagline">{dict.tagline}</p>
      </div>
      <div class="tq-hero-rule" />
    </section>

    <Featured lang={lang} />

    <section class="tq-sec">
      <div class="tq-sechead">
        <div>
          <h2>{dict.projectsTitle}</h2>
          <p class="sub">{dict.projectsSub}</p>
        </div>
      </div>
      <div class="tq-index">
        {projects.map((p, idx) => (
          <a class="tq-indexrow" href={`${base}projects/${p.slug}`}>
            <span class="n">{String(idx + 1).padStart(2, '0')}</span>
            <span class="t">{p.title}</span>
            <span class="d">{p.desc.en}</span>
            <span class="ar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="tq-sec">
      <div class="tq-sechead">
        <div>
          <h2>{dict.latestTitle}</h2>
          <p class="sub">{dict.latestSub}</p>
        </div>
      </div>

      <div class="tq-explore">
        <div class="tq-searchbox">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" class="tq-search-input" id="tq-search-input" placeholder={dict.searchPlaceholder} autocomplete="off" />
        </div>
        <div class="tq-chips" id="tq-chips">
          <button class="tq-chip on" data-cat="">{dict.filterAll}</button>
          {allCategories.map(c => (
            <button class="tq-chip" data-cat={c.toLowerCase()}>{c}</button>
          ))}
        </div>
        <span class="tq-langnote">▸ <b>{dict.inThisLang}</b> highlighted</span>
      </div>

      <div class="tq-rowlist" id="tq-rowlist">
        {sortedPosts.map(post => {
          const postPath = post.file.includes('/murderheprompted/')
            ? 'murderheprompted/'
            : post.file.includes('/shortstories/')
            ? 'shortstories/'
            : post.file.includes('/promptsoncanvas/')
            ? 'promptsoncanvas/'
            : 'ideas/';
          const slug = post.file.split('/').pop()?.replace(/\.(md|mdx)$/, '');
          const href = `${base}${postPath}${slug}`;
          const fm = post.frontmatter;
          const match = fm.lang === 'en';
          const cats = fm.categories || [];
          return (
            <a class={"tq-row" + (match ? " match" : "")} href={href}
              data-title={fm.title.toLowerCase()}
              data-cats={(cats as string[]).join(' ').toLowerCase()}
              data-lang={fm.lang}>
              <span class="rdate">{fmtDate(fm.date)}</span>
              <span class="rtitle">{fm.title}</span>
              <span class="rtags">
                <span class={"tq-langbadge" + (match ? " filled" : "")}>{fm.lang}</span>
                {cats.length > 0 && <span class="tq-cat">{cats[0]}</span>}
              </span>
            </a>
          );
        })}
      </div>
    </section>

  </div>
</Layout>

<script>
  const input = document.getElementById('tq-search-input') as HTMLInputElement | null;
  const chips = document.querySelectorAll('#tq-chips .tq-chip');
  const rows = document.querySelectorAll('#tq-rowlist .tq-row');

  let activeCat = '';

  function filterRows() {
    const q = input?.value.toLowerCase().trim() || '';
    rows.forEach((row) => {
      const title = (row as HTMLElement).dataset.title || '';
      const cats = (row as HTMLElement).dataset.cats || '';
      const matchesSearch = !q || title.includes(q) || cats.includes(q);
      const matchesCat = !activeCat || cats.includes(activeCat);
      (row as HTMLElement).hidden = !(matchesSearch && matchesCat);
    });
  }

  input?.addEventListener('input', filterRows);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('on'));
      chip.classList.add('on');
      activeCat = (chip as HTMLElement).dataset.cat || '';
      filterRows();
    });
  });
</script>

<style>
  .tq-home{width:100%;}

  .tq-hero-monumental{padding:72px 0 40px;}
  .tq-hero-inner{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--grid-unit);flex-wrap:wrap;}
  .tq-hero-inner h1{font-family:var(--font-heading-primary);font-weight:700;color:var(--color-accent);
    text-transform:uppercase;letter-spacing:.1em;font-size:7.5rem;line-height:.8;margin:0;}
  .tq-tagline{font-family:var(--font-heading-secondary);font-weight:700;color:var(--color-text-muted);
    text-transform:uppercase;letter-spacing:.16em;font-size:1.2rem;margin:0 0 12px;text-align:right;}
  .tq-hero-rule{height:6px;background:var(--color-accent);margin-top:24px;}

  .tq-sec{padding:56px 0;}
  .tq-sechead{display:flex;align-items:baseline;justify-content:space-between;gap:var(--grid-unit);
    margin-bottom:32px;flex-wrap:wrap;}
  .tq-sechead h2{font-family:var(--font-heading-secondary);font-weight:700;text-transform:uppercase;
    letter-spacing:.1em;color:var(--color-accent);font-size:1.9rem;margin:0;}
  .tq-sechead .sub{color:var(--color-text-secondary);font-size:1rem;margin:0;}

  .tq-index{border-top:2px solid var(--color-text-primary);}
  .tq-indexrow{display:flex;align-items:center;gap:24px;padding:20px 4px;
    border-bottom:1px solid var(--color-border);text-decoration:none;cursor:pointer;transition:.2s;}
  .tq-indexrow:hover{padding-left:16px;background:var(--color-surface);}
  .tq-indexrow .n{font-family:var(--font-mono);font-size:.85rem;font-weight:700;color:var(--color-accent);width:34px;flex:none;}
  .tq-indexrow .t{font-family:var(--font-heading-secondary);font-weight:700;text-transform:uppercase;
    letter-spacing:.05em;color:var(--color-text-primary);font-size:1.45rem;flex:none;}
  .tq-indexrow .d{color:var(--color-text-muted);font-size:.98rem;flex:1;text-align:right;}
  .tq-indexrow .ar{color:var(--color-accent);opacity:0;transform:translateX(-6px);transition:.2s;}
  .tq-indexrow:hover .ar{opacity:1;transform:translateX(0);}

  .tq-explore{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:28px;}
  .tq-searchbox{position:relative;flex:1;min-width:220px;}
  .tq-searchbox input{width:100%;font-family:var(--font-body);font-size:1rem;color:var(--color-text-primary);
    background:var(--color-background);border:1.5px solid var(--color-border);border-radius:6px;
    padding:11px 14px 11px 40px;outline:none;transition:.18s;}
  .tq-searchbox input:focus{border-color:var(--color-accent);}
  .tq-searchbox input::placeholder{color:var(--color-text-muted);}
  .tq-searchbox svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);}
  .tq-chips{display:flex;gap:8px;flex-wrap:wrap;}
  .tq-chip{font-family:var(--font-mono);font-size:.74rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
    border:1.5px solid var(--color-border);background:var(--color-background);color:var(--color-text-secondary);
    border-radius:999px;padding:7px 13px;cursor:pointer;transition:.16s;}
  .tq-chip:hover{border-color:var(--color-accent);color:var(--color-accent);}
  .tq-chip.on{background:var(--color-text-primary);color:var(--color-background);border-color:var(--color-text-primary);}
  .tq-langnote{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.04em;color:var(--color-text-muted);
    display:inline-flex;align-items:center;gap:7px;}
  .tq-langnote b{color:var(--color-accent);}

  .tq-rowlist{display:flex;flex-direction:column;}
  .tq-row{display:grid;grid-template-columns:130px 1fr auto;gap:20px;align-items:center;
    padding:18px 6px;border-bottom:1px solid var(--color-border);text-decoration:none;
    cursor:pointer;transition:.18s;}
  .tq-row:first-child{border-top:1px solid var(--color-border);}
  .tq-row:hover{background:var(--color-surface);padding-left:12px;}
  .tq-row .rdate{font-family:var(--font-mono);font-size:.76rem;text-transform:uppercase;letter-spacing:.04em;color:var(--color-text-muted);}
  .tq-row .rtitle{font-family:var(--font-heading-secondary);font-weight:700;font-size:1.25rem;letter-spacing:.02em;color:var(--color-text-primary);}
  .tq-row:hover .rtitle{color:var(--color-accent);}
  .tq-row.match .rtitle{border-left:3px solid var(--color-accent);padding-left:10px;margin-left:-13px;}
  .tq-row .rtags{display:flex;gap:7px;align-items:center;}
  .tq-langbadge{font-family:var(--font-mono);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
    color:var(--color-accent);border:1px solid var(--color-border);border-radius:3px;padding:1px 6px;}
  .tq-langbadge.filled{background:var(--color-accent);color:#fff;border-color:var(--color-accent);}
  .tq-cat{background:var(--color-text-primary);color:var(--color-background);font-family:var(--font-mono);
    font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:3px 7px;border-radius:2px;}
  [data-theme="dark"] .tq-cat{background:#2a2a2a;color:#f5f5f5;border:1px solid var(--color-border);}

  @media (max-width:768px){
    .tq-hero-inner h1{font-size:4.5rem;}
    .tq-tagline{font-size:1rem;}
    .tq-indexrow .d{display:none;}
    .tq-indexrow .t{font-size:1.15rem;}
    .tq-row{grid-template-columns:1fr;gap:8px;}
    .tq-row .rdate{font-size:.7rem;}
    .tq-row .rtitle{font-size:1.05rem;}
  }
</style>
