---
import Layout from '../../components/Layout.astro';
import { localize, slugFromFile } from '../../utils/i18n';
const base = import.meta.env.BASE_URL;

const mdPostsGlob = import.meta.glob('../../content/ideas/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../../content/ideas/*.mdx', { eager: true });

const allPosts = [...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob)] as any[];
const sortedPosts = localize(allPosts, 'it')
  .sort((a, b) => new Date(b.post.frontmatter.date).getTime() - new Date(a.post.frontmatter.date).getTime())
  .map(({ post, isFallback }) => {
    const slug = slugFromFile(post.file);
    return {
      ...post,
      isFallback,
      url: `/ideas/${slug}`
    }
  });
---

<Layout title="Ideas" description="Random thoughts on AI, tech, time, archives.">
  <div class="blog-page">
    <header class="blog-header">
      <h1 class="blog-title">Ideas</h1>
      <p class="blog-description">
        Posts, short stories, random thoughts.
      </p>
      <hr class="blog-rule" />
    </header>

    {sortedPosts.length > 0 ? (
      <div class="posts-list">
        {sortedPosts.map((post: any) => (
          <article class="post-item">
            <h2 class="post-title">
              <a href={post.url}>{post.frontmatter.title}</a>
              {post.isFallback && <span class="fallback-badge">{post.frontmatter.lang.toUpperCase()}</span>}
            </h2>

            <div class="post-meta">
              <time class="post-date" datetime={post.frontmatter.date}>
                {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              
              {post.frontmatter.categories && (
                <div class="post-categories">
                  {post.frontmatter.categories.map((category: string) => (
                    <span class="category">{category}</span>
                  ))}
                </div>
              )}
            </div>
            
            {post.frontmatter.excerpt && (
              <p class="post-excerpt">{post.frontmatter.excerpt}</p>
            )}
            
            <a href={post.url} class="read-more">Read More →</a>
          </article>
        ))}
      </div>
    ) : (
      <div class="no-posts">
        <p>No posts available yet. Start writing by creating files in <code>src/content/ideas/</code></p>
      </div>
    )}
  </div>
</Layout>

<style>
  .blog-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-header {
    text-align: left;
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .blog-title {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .blog-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 4);
    max-width: 600px;
  }

  .blog-rule {
    height: 2px;
    background-color: var(--color-border-strong);
    border: none;
    width: 100%;
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--grid-unit) * 6);
  }

  .post-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: calc(var(--grid-unit) * 4);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-title {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .post-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover,
  .post-title a:focus {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: calc(var(--grid-unit));
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid-unit) / 2);
  }

  .category {
    font-family: var(--font-mono);
    background-color: var(--color-surface-alt);
    color: var(--color-text-secondary);
    padding: 2px 6px;
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-badge);
  }

  .fallback-badge {
    display: inline-block;
    margin-left: calc(var(--grid-unit));
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-badge);
    padding: 1px 5px;
    vertical-align: middle;
  }

  .post-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: calc(var(--grid-unit) * 2);
    font-size: 1.1rem;
  }

  .read-more {
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.72rem;
    transition: color 0.2s ease;
  }

  .read-more:hover,
  .read-more:focus {
    color: var(--color-text-primary);
  }

  .no-posts {
    text-align: center;
    padding: calc(var(--grid-unit) * 6);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .no-posts code {
    background-color: var(--color-surface);
    padding: 2px 4px;
    border-radius: 3px;
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .blog-title {
      font-size: 2.5rem;
    }

    .blog-description {
      font-size: 1.125rem;
    }

    .post-title {
      font-size: 1.75rem;
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>