---
import Layout from '../../components/Layout.astro';
import { localize, slugFromFile } from '../../utils/i18n';

const collectionName = 'shortstories';
const collectionGlob = import.meta.glob('../../content/shortstories/**/*.{md,mdx}', { eager: true });
const allPosts = Object.values(collectionGlob) as any[];

const posts = localize(allPosts, 'it')
  .sort((a, b) => new Date(b.post.frontmatter.date).getTime() - new Date(a.post.frontmatter.date).getTime());

const base = import.meta.env.BASE_URL;
---

<Layout title="Short stories" description="An archive for a couple of short stories I've written back in the day.">
  <div class="project-page">
    <p class="breadcrumb"><a href={`${base}projects`}>progetti</a> / short-stories</p>

    <header class="page-head">
      <div>
        <p class="kicker">Narrativa · Racconti</p>
        <h1 class="page-title">Collected<br />short stories</h1>
        <p class="page-description">An archive for a couple of short stories I've written back in the day.</p>
      </div>
      <span class="ghost-num">{String(posts.length).padStart(2, '0')}</span>
    </header>

    <div class="sort-controls">
      <button id="sort-toggle">Sort by Date (Oldest First)</button>
    </div>

    <section class="cases">
      <h2 class="cases-label">Racconti</h2>
      <div class="cases-list posts-list">
        {posts.map(({ post, isFallback }, idx: number) => (
          <a class="case-row post-item" href={`${base}${collectionName}/${slugFromFile(post.file)}`}>
            <span class="num">#{idx + 1}</span>
            <div class="case-body">
              <div class="case-title">
                {post.frontmatter.title}
                {isFallback && <span class="fallback-badge">{post.frontmatter.lang.toUpperCase()}</span>}
              </div>
              {post.frontmatter.excerpt && <div class="case-desc">{post.frontmatter.excerpt}</div>}
            </div>
            <time class="case-date post-date" datetime={post.frontmatter.date}>
              {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  const sortToggle = document.getElementById('sort-toggle');
  if (sortToggle) {
    const postsList = document.querySelector('.posts-list');
    const posts = Array.from(postsList.querySelectorAll('.post-item'));

    let isAscending = false;

    sortToggle.addEventListener('click', () => {
      isAscending = !isAscending;
      sortToggle.textContent = isAscending ? 'Sort by Date (Newest First)' : 'Sort by Date (Oldest First)';

      posts.sort((a, b) => {
        const dateA = new Date(a.querySelector('.post-date').getAttribute('datetime'));
        const dateB = new Date(b.querySelector('.post-date').getAttribute('datetime'));

        if (isAscending) {
          return dateA.getTime() - dateB.getTime();
        } else {
          return dateB.getTime() - dateA.getTime();
        }
      });

      posts.forEach(post => postsList.appendChild(post));
    });
  }
</script>

<style>
  .project-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 44px 0 60px;
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 26px;
  }

  .breadcrumb a {
    color: var(--color-accent);
  }

  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin: 0 0 14px;
  }

  .page-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .ghost-num {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 1;
    color: var(--color-surface-alt);
    flex: none;
  }

  .sort-controls {
    margin-bottom: calc(var(--grid-unit) * 3);
    text-align: right;
  }

  #sort-toggle {
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    padding: 7px 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #sort-toggle:hover,
  #sort-toggle:focus {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cases-label {
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin: 0 0 14px;
  }

  .cases-list {
    border-top: 2px solid var(--color-border-strong);
  }

  .case-row {
    display: grid;
    grid-template-columns: 50px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 22px 2px;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .case-row:hover {
    background: var(--color-surface);
  }

  .case-row .num {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-accent);
  }

  .case-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .case-row:hover .case-title {
    color: var(--color-accent);
  }

  .case-desc {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .fallback-badge {
    display: inline-block;
    margin-left: calc(var(--grid-unit));
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-badge);
    padding: 1px 5px;
    vertical-align: middle;
  }

  .case-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .page-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .ghost-num {
      display: none;
    }

    .case-row {
      grid-template-columns: 32px 1fr;
    }

    .case-date {
      grid-column: 2;
    }
  }
</style>
